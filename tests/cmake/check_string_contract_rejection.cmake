# Verify that unsupported String client contract signatures are rejected by
# the real native compiler with the intended type diagnostic, not any failure.
if(NOT DEFINED ORES_COMPILER OR NOT DEFINED ORES_FIXTURE)
    message(FATAL_ERROR "missing native compiler or fixture")
endif()
execute_process(COMMAND "${ORES_COMPILER}" "${ORES_FIXTURE}"
    RESULT_VARIABLE exit_code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if("${exit_code}" STREQUAL "0")
    message(FATAL_ERROR "String client contract was unexpectedly admitted")
endif()
string(FIND "${stderr}" "expected 'int'" expected_type)
if(expected_type EQUAL -1)
    message(FATAL_ERROR "wrong rejection reason: ${stderr}")
endif()
get_filename_component(fixture_name "${ORES_FIXTURE}" NAME)
string(FIND "${stderr}" "[file: ${fixture_name}]" source_location)
if(source_location EQUAL -1)
    message(FATAL_ERROR "compiler rejection omitted source filename: ${stderr}")
endif()

# A native source rejection must never reveal its full filesystem path or
# emit terminal-control sequences while rendering the error context.
string(FIND "${stderr}" "${ORES_FIXTURE}" leaked_absolute_source_path)
if(NOT leaked_absolute_source_path EQUAL -1)
    message(FATAL_ERROR "compiler diagnostic leaked absolute source path")
endif()
string(ASCII 27 ansi_escape)
string(FIND "${stderr}" "${ansi_escape}" escape_marker)
if(NOT escape_marker EQUAL -1)
    message(FATAL_ERROR "compiler diagnostic contained terminal escape")
endif()
string(LENGTH "${stderr}" diagnostic_size)
if(diagnostic_size GREATER 3072)
    message(FATAL_ERROR "compiler diagnostic exceeded bounded output")
endif()
