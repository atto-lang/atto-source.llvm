if(NOT DEFINED ORES_LLVM_COMPILER OR NOT DEFINED ORES_SOURCE)
    message(FATAL_ERROR "missing isolate negative-test arguments")
endif()
execute_process(COMMAND "${ORES_LLVM_COMPILER}" "--isolate-entry=tenant_step" "${ORES_SOURCE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE ir ERROR_VARIABLE diagnostics)
if(status STREQUAL "0")
    message(FATAL_ERROR "invalid isolate source was incorrectly accepted")
endif()
if(NOT ir STREQUAL "")
    message(FATAL_ERROR "invalid isolate source emitted partial LLVM IR")
endif()
if(diagnostics STREQUAL "")
    message(FATAL_ERROR "invalid isolate source failed without a diagnostic")
endif()
