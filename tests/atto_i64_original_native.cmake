cmake_minimum_required(VERSION 3.20)
# Call the real exported i64 __oreslang_guest_main of the UNCHANGED .atto
# source. The LLVM compiler also emits a C i32 main; rename that symbol in
# the ELF object, leaving the actual guest function intact, and link a
# fixed native C oracle to compare the full 64-bit result.
if(NOT DEFINED MODE OR NOT (MODE STREQUAL "validate" OR MODE STREQUAL "native"))
  message(FATAL_ERROR "original-i64 mode must be validate or native")
endif()
if(NOT DEFINED CORPUS OR NOT EXISTS "${CORPUS}")
  message(FATAL_ERROR "original-i64 missing corpus")
endif()
file(SHA256 "${CORPUS}" corpus_sha)
if(NOT corpus_sha STREQUAL "5fd8ed522dfaaead8dc1b2d780159a4f156482124b7515d0a788245fc594ebc8")
  message(FATAL_ERROR "original-i64 corpus differs from canonical JS bytes")
endif()
file(READ "${CORPUS}" manifest LIMIT 65536)
string(JSON schema ERROR_VARIABLE json_error GET "${manifest}" schemaVersion)
if(json_error OR NOT schema EQUAL 1)
  message(FATAL_ERROR "original-i64 schema mismatch")
endif()
string(JSON model ERROR_VARIABLE json_error GET "${manifest}" integerModel)
if(json_error OR NOT model STREQUAL "signed-i64-checked-provisional")
  message(FATAL_ERROR "original-i64 model mismatch")
endif()
string(JSON count ERROR_VARIABLE json_error LENGTH "${manifest}" cases)
if(json_error OR NOT count EQUAL 50)
  message(FATAL_ERROR "original-i64 must have exactly 50 fixtures")
endif()
if(MODE STREQUAL "native")
  if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR
     NOT EXISTS "${COMPILER}" OR NOT EXISTS "${CLANG}" OR
     NOT EXISTS "${OBJCOPY}" OR NOT EXISTS "${SHIM}" OR
     NOT EXISTS "${SOURCE_DIR}/CMakeLists.txt" OR
     NOT DEFINED WORKDIR OR WORKDIR STREQUAL "" OR WORKDIR STREQUAL "/")
    message(FATAL_ERROR "original-i64 requires Linux, real compiler, Clang, objcopy, fixed oracle and isolated source checkout")
  endif()
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE head_rc TIMEOUT 5)
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse "HEAD^{tree}"
    OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE tree_rc TIMEOUT 5)
  string(LENGTH "${head}" head_len)
  string(LENGTH "${tree}" tree_len)
  if(NOT head_rc STREQUAL "0" OR NOT tree_rc STREQUAL "0" OR
     NOT head_len EQUAL 40 OR NOT tree_len EQUAL 40 OR
     NOT head MATCHES "^[a-f0-9]+$" OR NOT tree MATCHES "^[a-f0-9]+$")
    message(FATAL_ERROR "original-i64 invalid Git source revision")
  endif()
  if(DEFINED EXPECTED_SOURCE_SHA AND NOT EXPECTED_SOURCE_SHA STREQUAL "" AND
     NOT EXPECTED_SOURCE_SHA STREQUAL head)
    message(FATAL_ERROR "original-i64 wrong checkout HEAD")
  endif()
  file(MAKE_DIRECTORY "${WORKDIR}")
  if(IS_SYMLINK "${WORKDIR}")
    message(FATAL_ERROR "original-i64 symlinked workdir rejected")
  endif()
  set(canonical_report "${WORKDIR}/llvm-original-i64-native-receipt.json")
  if(NOT DEFINED REPORT OR REPORT STREQUAL "")
    set(REPORT "${canonical_report}")
  elseif(NOT REPORT STREQUAL canonical_report)
    message(FATAL_ERROR "original-i64 receipt must stay inside designated workdir")
  endif()
  if(IS_DIRECTORY "${REPORT}")
    message(FATAL_ERROR "original-i64 receipt is a directory")
  endif()
  file(REMOVE "${REPORT}")
  if(EXISTS "${REPORT}")
    message(FATAL_ERROR "cannot clear stale original-i64 receipt")
  endif()
  file(SHA256 "${COMPILER}" compiler_sha)
  file(SHA256 "${CLANG}" clang_sha)
  file(SHA256 "${OBJCOPY}" objcopy_sha)
  file(SHA256 "${SHIM}" shim_sha)
  foreach(opt IN ITEMS O0 O2)
    execute_process(COMMAND "${CLANG}" "-${opt}" -std=c11 -Wall -Wextra -Werror -c "${SHIM}"
      -o "${WORKDIR}/original-i64-oracle.${opt}.o"
      RESULT_VARIABLE oracle_rc ERROR_VARIABLE oracle_stderr TIMEOUT 20)
    if(NOT oracle_rc STREQUAL "0")
      message(FATAL_ERROR "native original-i64 oracle compile failure: ${oracle_stderr}")
    endif()
  endforeach()
  set(rows "")
endif()
set(prefix "// oreslang:checked-i64-v1\npub fnc main(): int {return ")
set(suffix ";}\n")
string(LENGTH "${prefix}" prefix_len)
string(LENGTH "${suffix}" suffix_len)
set(ids "")
set(values 0)
set(overflows 0)
foreach(i RANGE 0 49)
  string(JSON id ERROR_VARIABLE json_error GET "${manifest}" cases ${i} id)
  if(json_error OR NOT id MATCHES "^[a-z][a-z0-9-]+$" OR id IN_LIST ids)
    message(FATAL_ERROR "duplicate/invalid original-i64 ID at index ${i}")
  endif()
  list(APPEND ids "${id}")
  string(JSON source ERROR_VARIABLE json_error GET "${manifest}" cases ${i} source)
  if(json_error)
    message(FATAL_ERROR "missing original-i64 source ${id}")
  endif()
  string(LENGTH "${source}" length)
  math(EXPR expr_len "${length} - ${prefix_len} - ${suffix_len}")
  if(expr_len LESS 1)
    message(FATAL_ERROR "invalid original-i64 source length ${id}")
  endif()
  string(SUBSTRING "${source}" ${prefix_len} ${expr_len} expression)
  if(NOT expression MATCHES "^[0-9()+* -]+$" OR
     NOT source STREQUAL "${prefix}${expression}${suffix}")
    message(FATAL_ERROR "invalid original-i64 source syntax ${id}")
  endif()
  string(JSON kind ERROR_VARIABLE json_error GET "${manifest}" cases ${i} expected kind)
  if(json_error)
    message(FATAL_ERROR "missing original-i64 numeric expectation ${id}")
  endif()
  if(kind STREQUAL "checked-overflow")
    math(EXPR overflows "${overflows}+1")
    continue()
  endif()
  if(NOT kind STREQUAL "value")
    message(FATAL_ERROR "unexpected original-i64 case kind ${id}")
  endif()
  math(EXPR values "${values}+1")
  string(JSON expected ERROR_VARIABLE json_error GET "${manifest}" cases ${i} expected value)
  if(json_error OR NOT expected MATCHES "^-?(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "invalid original-i64 expected value ${id}")
  endif()
  if(MODE STREQUAL "native")
    set(stem "${WORKDIR}/original-i64-${i}")
    set(source_file "${stem}.atto")
    set(ir_file "${stem}.ll")
    file(REMOVE "${ir_file}" "${stem}.O0.o" "${stem}.O2.o"
      "${stem}.O0.native" "${stem}.O2.native")
    file(WRITE "${source_file}" "${source}")
    file(SHA256 "${source_file}" source_sha)
    execute_process(COMMAND "${COMPILER}" "${source_file}"
      RESULT_VARIABLE compile_rc OUTPUT_FILE "${ir_file}"
      ERROR_VARIABLE compile_stderr TIMEOUT 15)
    if(NOT compile_rc STREQUAL "0" OR NOT EXISTS "${ir_file}")
      message(FATAL_ERROR "compiler failed original-i64 ${id}: ${compile_rc}: ${compile_stderr}")
    endif()
    file(SIZE "${ir_file}" ir_size)
    if(ir_size LESS 16 OR ir_size GREATER 131072)
      message(FATAL_ERROR "invalid original-i64 IR size ${id}")
    endif()
    file(READ "${ir_file}" ir LIMIT 131072)
    if(NOT ir MATCHES "define.*@__oreslang_guest_main" OR
       NOT ir MATCHES "define.*@main")
      message(FATAL_ERROR "missing original exported guest i64 or host main symbol ${id}")
    endif()
    file(SHA256 "${ir_file}" ir_sha)
    foreach(opt IN ITEMS O0 O2)
      set(object_file "${stem}.${opt}.o")
      set(native_file "${stem}.${opt}.native")
      execute_process(COMMAND "${CLANG}" "-${opt}" -Wno-override-module -x ir -c
        "${ir_file}" -o "${object_file}" RESULT_VARIABLE object_rc
        ERROR_VARIABLE object_stderr TIMEOUT 20)
      if(NOT object_rc STREQUAL "0" OR NOT EXISTS "${object_file}")
        message(FATAL_ERROR "original-i64 native object ${id}/${opt}: ${object_stderr}")
      endif()
      execute_process(COMMAND "${OBJCOPY}" --redefine-sym main=atto_original_exit_wrapper
        "${object_file}" RESULT_VARIABLE rename_rc ERROR_VARIABLE rename_stderr TIMEOUT 10)
      if(NOT rename_rc STREQUAL "0")
        message(FATAL_ERROR "cannot isolate original-i64 guest from OS wrapper: ${rename_stderr}")
      endif()
      execute_process(COMMAND "${CLANG}" "-${opt}" "${WORKDIR}/original-i64-oracle.${opt}.o"
        "${object_file}" -o "${native_file}" RESULT_VARIABLE link_rc
        ERROR_VARIABLE link_stderr TIMEOUT 20)
      if(NOT link_rc STREQUAL "0" OR NOT EXISTS "${native_file}")
        message(FATAL_ERROR "original-i64 guest link ${id}/${opt}: ${link_stderr}")
      endif()
      execute_process(COMMAND "${native_file}" "${expected}"
        RESULT_VARIABLE result OUTPUT_VARIABLE guest_out ERROR_VARIABLE guest_err TIMEOUT 5)
      if(NOT result STREQUAL "42" OR NOT guest_out STREQUAL "" OR NOT guest_err STREQUAL "")
        message(FATAL_ERROR "unchanged original-i64 guest failed ${id}/${opt}: exit=${result}; stdout=${guest_out}; stderr=${guest_err}")
      endif()
      set("result_${opt}" "${result}")
    endforeach()
    if(NOT rows STREQUAL "")
      string(APPEND rows ",\n")
    endif()
    string(APPEND rows
      "    {\"id\":\"${id}\",\"expected_i64\":\"${expected}\",\"source_sha256\":\"${source_sha}\",\"ir_sha256\":\"${ir_sha}\",\"observed_exit_o0\":${result_O0},\"observed_exit_o2\":${result_O2}}")
  endif()
endforeach()
if(NOT values EQUAL 37 OR NOT overflows EQUAL 13)
  message(FATAL_ERROR "original-i64 source inventory changed")
endif()
if(MODE STREQUAL "native")
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE after_head OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE after_head_rc TIMEOUT 5)
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse "HEAD^{tree}"
    OUTPUT_VARIABLE after_tree OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE after_tree_rc TIMEOUT 5)
  file(SHA256 "${CORPUS}" after_corpus_sha)
  file(SHA256 "${COMPILER}" after_compiler_sha)
  file(SHA256 "${CLANG}" after_clang_sha)
  file(SHA256 "${OBJCOPY}" after_objcopy_sha)
  file(SHA256 "${SHIM}" after_shim_sha)
  if(NOT after_head_rc STREQUAL "0" OR NOT after_tree_rc STREQUAL "0" OR
     NOT after_head STREQUAL head OR NOT after_tree STREQUAL tree OR
     NOT after_corpus_sha STREQUAL corpus_sha OR
     NOT after_compiler_sha STREQUAL compiler_sha OR
     NOT after_clang_sha STREQUAL clang_sha OR
     NOT after_objcopy_sha STREQUAL objcopy_sha OR
     NOT after_shim_sha STREQUAL shim_sha)
    message(FATAL_ERROR "original-i64 source or tool identity changed mid-run")
  endif()
  file(WRITE "${REPORT}" "{\n  \"schema\":\"atto-llvm-original-i64-native-v1\",\n  \"verification\":\"LLVM_ORIGINAL_SOURCE_GUEST_EXECUTED\",\n  \"source_head\":\"${head}\",\n  \"source_tree\":\"${tree}\",\n  \"corpus_sha256\":\"${corpus_sha}\",\n  \"compiler_sha256\":\"${compiler_sha}\",\n  \"clang_sha256\":\"${clang_sha}\",\n  \"objcopy_sha256\":\"${objcopy_sha}\",\n  \"probe_sha256\":\"${shim_sha}\",\n  \"optimization_modes\":[\"O0\",\"O2\"],\n  \"original_value_cases\":37,\n  \"executed_guest_processes\":74,\n  \"results\":[\n${rows}\n  ]\n}\n")
  message(STATUS "Native original-source i64 value cases: 37/37 O0+O2; 74 guest processes")
else()
  message(STATUS "HOST-ONLY original-source i64 candidate inventory: ${values} values and ${overflows} overflow expectations")
endif()
