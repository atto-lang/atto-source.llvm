cmake_minimum_required(VERSION 3.20)
# Distinguish manifest-only admission from real LLVM compiler + native guests.
if(NOT DEFINED MODE OR NOT (MODE STREQUAL "validate" OR MODE STREQUAL "native"))
  message(FATAL_ERROR "checked-i64 MODE must be validate or native")
endif()
if(NOT DEFINED CORPUS OR NOT EXISTS "${CORPUS}" OR IS_DIRECTORY "${CORPUS}")
  message(FATAL_ERROR "checked-i64 candidate corpus is missing")
endif()
set(PINNED_SHA256 "5fd8ed522dfaaead8dc1b2d780159a4f156482124b7515d0a788245fc594ebc8")
file(SHA256 "${CORPUS}" sha256)
if(NOT sha256 STREQUAL PINNED_SHA256)
  message(FATAL_ERROR "checked-i64 candidate JSON differs from JS exact-source manifest")
endif()
file(READ "${CORPUS}" json LIMIT 65536)
string(JSON schema ERROR_VARIABLE json_error GET "${json}" schemaVersion)
if(json_error OR NOT schema EQUAL 1)
  message(FATAL_ERROR "invalid checked-i64 corpus schema")
endif()
string(JSON model ERROR_VARIABLE json_error GET "${json}" integerModel)
if(json_error OR NOT model STREQUAL "signed-i64-checked-provisional")
  message(FATAL_ERROR "unexpected candidate numeric model")
endif()
string(JSON total ERROR_VARIABLE json_error LENGTH "${json}" cases)
if(json_error OR NOT total EQUAL 50)
  message(FATAL_ERROR "checked-i64 corpus requires exactly fifty cases")
endif()
if(MODE STREQUAL "native")
  if(NOT DEFINED COMPILER OR NOT EXISTS "${COMPILER}" OR IS_DIRECTORY "${COMPILER}" OR
     NOT DEFINED CLANG OR NOT EXISTS "${CLANG}" OR IS_DIRECTORY "${CLANG}")
    message(FATAL_ERROR "checked-i64 native test requires actual oreslang-llvmc and Clang")
  endif()
  if(NOT DEFINED WORKDIR OR WORKDIR STREQUAL "" OR WORKDIR STREQUAL "/" OR
     NOT DEFINED SOURCE_DIR OR NOT EXISTS "${SOURCE_DIR}/CMakeLists.txt")
    message(FATAL_ERROR "checked-i64 native test requires a source checkout and work directory")
  endif()
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE head_code TIMEOUT 5)
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse "HEAD^{tree}"
    OUTPUT_VARIABLE tree OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE tree_code TIMEOUT 5)
  if(NOT head_code STREQUAL "0" OR NOT tree_code STREQUAL "0" OR
     NOT head MATCHES "^[a-f0-9]+$" OR NOT tree MATCHES "^[a-f0-9]+$")
    message(FATAL_ERROR "missing checked-i64 source Git head/tree")
  endif()
  if(DEFINED EXPECTED_SOURCE_SHA AND NOT "${EXPECTED_SOURCE_SHA}" STREQUAL "" AND
     NOT "${EXPECTED_SOURCE_SHA}" STREQUAL "${head}")
    message(FATAL_ERROR "checked-i64 source checkout does not match exact reviewed head")
  endif()
  file(MAKE_DIRECTORY "${WORKDIR}")
  file(SHA256 "${COMPILER}" compiler_sha256)
  file(SHA256 "${CLANG}" clang_sha256)
  set(observations "")
endif()
set(prefix "// oreslang:checked-i64-v1\npub fnc main(): int {return ")
set(suffix ";}\n")
string(LENGTH "${prefix}" prelen)
string(LENGTH "${suffix}" suffixlen)
set(ids "")
set(value_count 0)
set(trap_count 0)
foreach(i RANGE 0 49)
  string(JSON id ERROR_VARIABLE json_error GET "${json}" cases ${i} id)
  if(json_error OR NOT id MATCHES "^[a-z][a-z0-9-]+$")
    message(FATAL_ERROR "invalid checked-i64 candidate ID at index ${i}")
  endif()
  if(id IN_LIST ids)
    message(FATAL_ERROR "duplicate checked-i64 candidate ID")
  endif()
  list(APPEND ids "${id}")
  string(JSON source ERROR_VARIABLE json_error GET "${json}" cases ${i} source)
  if(json_error)
    message(FATAL_ERROR "checked-i64 source is missing for ${id}")
  endif()
  string(LENGTH "${source}" sourcelen)
  math(EXPR expressionlen "${sourcelen} - ${prelen} - ${suffixlen}")
  if(expressionlen LESS 1)
    message(FATAL_ERROR "invalid checked-i64 candidate source length")
  endif()
  string(SUBSTRING "${source}" ${prelen} ${expressionlen} expression)
  if(NOT expression MATCHES "^[0-9()+* -]+$" OR
     NOT "${source}" STREQUAL "${prefix}${expression}${suffix}")
    message(FATAL_ERROR "checked-i64 source grammar/bytes mismatch for ${id}")
  endif()
  string(JSON kind ERROR_VARIABLE json_error GET "${json}" cases ${i} expected kind)
  if(json_error)
    message(FATAL_ERROR "missing checked-i64 expectation for ${id}")
  endif()
  if(kind STREQUAL "value")
    math(EXPR value_count "${value_count}+1")
    string(JSON expected ERROR_VARIABLE json_error GET "${json}" cases ${i} expected value)
    if(json_error OR NOT expected MATCHES "^-?(0|[1-9][0-9]*)$")
      message(FATAL_ERROR "invalid signed-i64 expected value for ${id}")
    endif()
    # Verify the FULL i64 result inside the guest, not its truncated process
    # exit status. The only host-visible success is exact equality -> 42.
    set(native_source "pub fnc main(): int {\n  if ((${expression}) eq (${expected})) { return 42; } fi\n  return 43;\n}\n")
  elseif(kind STREQUAL "checked-overflow")
    math(EXPR trap_count "${trap_count}+1")
    # Overflow candidates preserve the JS source bytes exactly.
    set(native_source "${source}")
  else()
    message(FATAL_ERROR "unknown checked-i64 outcome kind for ${id}")
  endif()
  if(MODE STREQUAL "native")
    set(base "${WORKDIR}/checked-${i}")
    set(source_file "${base}.atto")
    set(ir_file "${base}.ll")
    set(native_file "${base}.native")
    file(REMOVE "${ir_file}" "${native_file}")
    file(WRITE "${source_file}" "${native_source}")
    file(SHA256 "${source_file}" native_source_sha256)
    # The expression hash is based on the exact unchanged JS source program.
    # For value cases the equality wrapper is a second, recorded artifact.
    set(source_sha_file "${base}.original")
    file(WRITE "${source_sha_file}" "${source}")
    file(SHA256 "${source_sha_file}" original_source_sha256)
    execute_process(COMMAND "${COMPILER}" "${source_file}"
      RESULT_VARIABLE compile_code OUTPUT_FILE "${ir_file}"
      ERROR_VARIABLE compile_stderr TIMEOUT 10)
    if(NOT "${compile_code}" STREQUAL "0" OR NOT EXISTS "${ir_file}")
      message(FATAL_ERROR "LLVM checked-i64 compile failed ${id}: ${compile_code}: ${compile_stderr}")
    endif()
    file(SIZE "${ir_file}" ir_size)
    if(ir_size LESS 16 OR ir_size GREATER 131072)
      message(FATAL_ERROR "invalid bounded LLVM checked-i64 IR for ${id}")
    endif()
    if(kind STREQUAL "checked-overflow")
      file(READ "${ir_file}" ir_text LIMIT 131072)
      if(NOT ir_text MATCHES "llvm[.]trap" OR
         NOT ir_text MATCHES "with[.]overflow")
        message(FATAL_ERROR "overflow candidate lacks checked-i64 trap lowering: ${id}")
      endif()
    endif()
    execute_process(COMMAND "${CLANG}" -Wno-override-module -x ir "${ir_file}" -o "${native_file}"
      RESULT_VARIABLE link_code OUTPUT_VARIABLE link_stdout
      ERROR_VARIABLE link_stderr TIMEOUT 20)
    if(NOT "${link_code}" STREQUAL "0" OR NOT EXISTS "${native_file}" OR
       NOT "${link_stdout}" STREQUAL "")
      message(FATAL_ERROR "LLVM checked-i64 link failed ${id}: ${link_code}: ${link_stderr}")
    endif()
    execute_process(COMMAND "${native_file}"
      RESULT_VARIABLE observed OUTPUT_VARIABLE guest_stdout
      ERROR_VARIABLE guest_stderr TIMEOUT 5)
    if(NOT "${guest_stdout}" STREQUAL "" OR NOT "${guest_stderr}" STREQUAL "")
      message(FATAL_ERROR "unexpected checked-i64 guest output for ${id}")
    endif()
    if(kind STREQUAL "value")
      if(NOT "${observed}" STREQUAL "42")
        message(FATAL_ERROR "incorrect full-width checked-i64 native value for ${id}: ${observed}")
      endif()
      set(native_observed "\"value-eq\"")
    else()
      # LLVM llvm.trap becomes SIGILL on x86-64 and may be SIGTRAP on other
      # supported native targets. Ordinary nonzero exits are NOT a trap proof.
      if(NOT "${observed}" MATCHES "^(Illegal instruction|Trace/breakpoint trap|Abort trap)$")
        message(FATAL_ERROR "overflow native guest did not trap ${id}: ${observed}")
      endif()
      set(native_observed "\"overflow-trap\"")
    endif()
    if(NOT observations STREQUAL "")
      string(APPEND observations ",\n")
    endif()
    string(APPEND observations
      "    {\"id\":\"${id}\",\"kind\":\"${kind}\",\"native_observed\":${native_observed},\"original_source_sha256\":\"${original_source_sha256}\",\"native_source_sha256\":\"${native_source_sha256}\"}")
  endif()
endforeach()
if(NOT value_count EQUAL 37 OR NOT trap_count EQUAL 13)
  message(FATAL_ERROR "checked-i64 candidate case counts have drifted")
endif()
if(MODE STREQUAL "native")
  if(NOT DEFINED REPORT OR REPORT STREQUAL "")
    set(REPORT "${WORKDIR}/llvm-checked-i64-native-receipt.json")
  endif()
  file(WRITE "${REPORT}" "{\n  \"schema\":\"atto-llvm-checked-i64-native-v1\",\n  \"verification\":\"LLVM_NATIVE_GUEST_EXECUTED\",\n  \"source_head\":\"${head}\",\n  \"source_tree\":\"${tree}\",\n  \"corpus_sha256\":\"${sha256}\",\n  \"compiler_sha256\":\"${compiler_sha256}\",\n  \"clang_sha256\":\"${clang_sha256}\",\n  \"values_checked\":${value_count},\n  \"overflow_guests_trapped\":${trap_count},\n  \"results\":[\n${observations}\n  ]\n}\n")
  message(STATUS "LLVM checked-i64 native guests: ${value_count} exact full-width values + ${trap_count} traps; receipt ${REPORT}")
else()
  message(STATUS "HOST-ONLY checked-i64 candidate admission: ${value_count} values, ${trap_count} overflow expectations")
endif()
