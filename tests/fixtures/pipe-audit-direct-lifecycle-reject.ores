define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeForwardMessages as Signal.Data end
define match pattern PipeBackwardMessages as Signal.Result end

define source pipe actor Stage0<forward_messages=PipeForwardMessages,backward_messages=PipeBackwardMessages> as
    state { value: int = 0; }
    receive_forward(PipeForwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.forward(Signal.Data(main()));
            }
        }
        return;
    }
    receive_backward(PipeBackwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.respond(Signal.Result(next));
            }
        }
        return;
    }
end
define transform pipe actor Stage1<forward_messages=PipeForwardMessages,backward_messages=PipeBackwardMessages> as
    state { value: int = 0; }
    receive_forward(PipeForwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.forward(Signal.Data(next));
            }
        }
        return;
    }
    receive_backward(PipeBackwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.backward(Signal.Result(next));
            }
        }
        return;
    }
end
define sink pipe actor Stage2<forward_messages=PipeForwardMessages,backward_messages=PipeBackwardMessages> as
    state { value: int = 0; }
    receive_forward(PipeForwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });
                self.backward(Signal.Result(next));
            }
        }
        return;
    }
end
pub fnc main(): int {
    const r0 = spawn Stage0();
    const r1 = spawn Stage1();
    const r2 = spawn Stage2();
    ActorUtils::pipe(r0, r1, r2);
    r0.send(Signal.Data(1));
    expect_pipeline(r0, 6);
    stop r2;
    stop r1;
    stop r0;
    return 43;
}
