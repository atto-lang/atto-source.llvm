define isolated actor Counter as
    state { count: int = 7; }
    pub on_message(int value): int {
        return self.handle_state(critical-read |s| -> {
            return s.count + value;
        });
    }
end
pub fnc main(): int {
    const worker = spawn Counter();
    worker.send(1);
    worker.send(2);
    stop worker;
    return 43;
}
