define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  await readable(2147483647) as ReadableOutcome outcome;
  worker.send(outcome == ReadableOutcome.Ready ? 1 :
              outcome == ReadableOutcome.Cancelled ? 2 : 3);
  stop worker;
  return outcome == ReadableOutcome.Failed ? 43 : 46;
}
