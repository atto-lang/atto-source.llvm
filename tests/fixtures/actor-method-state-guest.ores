// Compiled native method code executes against a real actor-owned heap.
// The test harness authenticates the actor turn and checks exact values.
define actor Counter as
    state { value: int = 7; }

    pub fnc get_handle(): int with state.read {
        return self.handle_state(|s| -> { return s.value; });
    }

    pub fnc get_using(): int with state.read {
        return using state.read(|s| -> { return s.value; });
    }

    pub fnc increment_handle(): int with state.read, state.write {
        return self.handle_state(critical |s| -> {
            s.value = s.value + 1;
            return s.value;
        });
    }

    pub fnc increment_using(): int with state.read, state.write {
        return using state.write(critical |s| -> {
            s.value = s.value + 1;
            return s.value;
        });
    }

    pub fnc reset(): int with state.write {
        return using state.write(critical |s| -> {
            s.value = 12;
            return 12;
        });
    }
end
