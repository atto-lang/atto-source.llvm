// Real four-actor compiled Oreslang pipeline. Typed result: 29.
define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeMessages as
    Signal.Data
    Signal.Result
end

define actor Source<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = state.value + n; return state.value; });
                self.forward(Signal.Data(next));
            }
            on Signal.Result as n { const next = self.handle_state(critical |state| -> { state.value = state.value + n; return state.value; }); }
        }
        return next;
    }
end
define actor TransformA<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n * 2; return state.value; });
                self.forward(Signal.Data(next));
            }
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 5; return state.value; });
                self.backward(Signal.Result(next));
            }
        }
        return next;
    }
end
define actor TransformB<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 4; return state.value; });
                self.forward(Signal.Data(next));
            }
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 2; return state.value; });
                self.backward(Signal.Result(next));
            }
        }
        return next;
    }
end
define actor Sink<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 3; return state.value; });
                self.backward(Signal.Result(next));
            }
            on Signal.Result as n { const next = self.handle_state(critical |state| -> { state.value = n; return state.value; }); }
        }
        return next;
    }
end
pub fnc main(): int {
    const source = spawn Source();
    const first = spawn TransformA();
    const second = spawn TransformB();
    const sink = spawn Sink();
    pipeline(source, first, second, sink);
    source.send(Signal.Data(5));
    expect_pipeline(source, 29);
    stop sink;
    stop second;
    stop first;
    stop source;
    return 43;
}
