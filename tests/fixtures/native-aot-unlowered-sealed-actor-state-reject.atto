// Historically this fixture rejected all sealed state. The compiler now
// lowers only non-suspending scalar state. Suspension while a critical actor
// turn owns the region must still fail before any LLVM IR is emitted.
define actor StrictCounter as {
  state {
    let count: int = 0;
  }
  pub critical suspends fnc handle_state(int delta): int {
    count = count + delta;
    return count;
  }
}
