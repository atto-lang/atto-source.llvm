define class Pair as
  pub let int left = 20;
  pub let int right = 11;
end
fnc inner(borrow mut int a): int { return a; }
fnc inspect(borrow mut int a, int b, int c): int { return a + b + c; }
pub fnc main(): int {
  let mut Pair pair = new Pair();
  return inspect(rt mut borrow pair.left, inner(rt mut borrow pair.right), inner(rt mut borrow pair.left));
}
