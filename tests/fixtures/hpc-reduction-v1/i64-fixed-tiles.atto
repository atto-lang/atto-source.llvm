// AttoLang HPC CPU v1: fixed i64 tile partials and canonical pairwise merge.
// Guest arithmetic executes through the compiler; this is not SIMD or multi-core.
fnc tile_sum(int a, int b, int c, int d): int {
  return ((a + b) + c) + d;
}
fnc ordered_merge(int a, int b, int c, int d): int {
  return (a + b) + (c + d);
}
pub fnc main(): int {
  return ordered_merge(
    tile_sum(1, 2, 3, 4),
    tile_sum(5, 6, 7, 8),
    tile_sum(-9, 11, 13, 15),
    tile_sum(-17, -18, 0, 11)
  );
}
