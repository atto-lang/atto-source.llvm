// Independent Oreslang-source guest for strided tensor-view bounds.
// An integer metadata predicate is not an owned buffer or actor/device loan.
// Mirrors the source-level logic in Java backend stdlib/tensor.ores.
// Exit 42 only if all positive AND negative cases execute as expected.
// Exact floor(r / s) for r >= 0, s > 0 without the '/' operator (int/int is
// a float in Java and unsupported natively) and without i64 overflow:
// recursive binary long division, depth <= 63.
fnc floor_div_double(int r, int s, int half): int {
  if (r - half * (s + s) >= s) { return half + half + 1; } fi
  return half + half;
}

fnc floor_div_nonneg(int r, int s): int {
  if (r < s) { return 0; } fi
  if (s > r - s) { return 1; } fi
  return floor_div_double(r, s, floor_div_nonneg(r, s + s));
}

fnc valid_tensor_span(int backing_elements, int start_element,
                      int element_count, int element_stride): int {
  if (backing_elements < 0) { return 0; } fi
  if (start_element < 0) { return 0; } fi
  if (element_count < 0) { return 0; } fi
  if (element_stride <= 0) { return 0; } fi
  if (start_element > backing_elements) { return 0; } fi
  if (element_count == 0) { return 1; } fi
  if (start_element == backing_elements) { return 0; } fi
  if (element_count - 1 > floor_div_nonneg(backing_elements - 1 - start_element, element_stride)) {
    return 0;
  } fi
  return 1;
}

// Native functions admit at most 8 guarded returns: run the vectors in
// three groups; exit codes 1..15 and 42 are unchanged.
fnc positive_cases(): int {
  if (valid_tensor_span(8, 0, 8, 1) != 1) { return 1; } fi
  if (valid_tensor_span(8, 1, 3, 3) != 1) { return 2; } fi
  if (valid_tensor_span(8, 8, 0, 3) != 1) { return 3; } fi
  if (valid_tensor_span(0, 0, 0, 1) != 1) { return 4; } fi
  if (valid_tensor_span(9223372036854775807, 9223372036854775806, 1, 1) != 1) {
    return 5;
  } fi
  return 0;
}

fnc negative_cases_a(): int {
  if (valid_tensor_span(8, 7, 2, 1) != 0) { return 6; } fi
  if (valid_tensor_span(8, 8, 1, 1) != 0) { return 7; } fi
  if (valid_tensor_span(8, 1, 2, 0) != 0) { return 8; } fi
  if (valid_tensor_span(8, 1, 2, -2) != 0) { return 9; } fi
  if (valid_tensor_span(9223372036854775807, 1, 9223372036854775807, 2) != 0) {
    return 10;
  } fi
  return 0;
}

fnc negative_cases_b(): int {
  if (valid_tensor_span(-1, 0, 0, 1) != 0) { return 11; } fi
  if (valid_tensor_span(8, -1, 1, 1) != 0) { return 12; } fi
  if (valid_tensor_span(8, 0, -1, 1) != 0) { return 13; } fi
  if (valid_tensor_span(8, 9, 0, 1) != 0) { return 14; } fi
  if (valid_tensor_span(8, 0, 3, 4) != 0) { return 15; } fi
  return 0;
}

pub fnc main(): int {
  val p: int = positive_cases();
  val a: int = negative_cases_a();
  val b: int = negative_cases_b();
  if (p != 0) { return p; } fi
  if (a != 0) { return a; } fi
  if (b != 0) { return b; } fi
  return 42;
}
