// Independent Oreslang-source guest for strided tensor-view bounds.
// An integer metadata predicate is not an owned buffer or actor/device loan.
// Mirrors the source-level logic in Java backend stdlib/tensor.ores.
// Exit 42 only if all positive AND negative cases execute as expected.

// Native sources have no int/int '/' (Java's '/' yields float) and no loop
// lowering, so the stride bound uses exact checked doubling instead:
// chunk/span grow as (2^k, 2^k * stride) while both still fit.
fnc chunk_count(int chunk, int span, int count, int room): int {
  if (chunk > count - chunk) { return chunk; } fi
  if (span > room - span) { return chunk; } fi
  return chunk_count(chunk + chunk, span + span, count, room);
}

fnc chunk_span(int chunk, int span, int count, int room): int {
  if (chunk > count - chunk) { return span; } fi
  if (span > room - span) { return span; } fi
  return chunk_span(chunk + chunk, span + span, count, room);
}

// Exactly (count * stride > room) for count, room >= 0 and stride >= 1,
// with no signed-i64 overflow on any path.
fnc product_exceeds(int count, int stride, int room): int {
  if (count == 0) { return 0; } fi
  if (stride > room) { return 1; } fi
  return product_exceeds(count - chunk_count(1, stride, count, room), stride,
                         room - chunk_span(1, stride, count, room));
}

fnc valid_tensor_span(int backing_elements, int start_element,
                      int element_count, int element_stride): int {
  if (backing_elements < 0) { return 0; } fi
  if (start_element < 0) { return 0; } fi
  if (element_count < 0) { return 0; } fi
  if (element_stride <= 0) { return 0; } fi
  if (start_element > backing_elements) { return 0; } fi
  if (element_count == 0) { return 1; } fi
  if (start_element == backing_elements) { return 0; } fi
  if (product_exceeds(element_count - 1, element_stride,
                      backing_elements - 1 - start_element) == 1) {
    return 0;
  } fi
  return 1;
}

// The native subset admits at most eight guarded returns per function, so
// the positive and negative tables are separate callables.
fnc first_positive_failure(): int {
  if (valid_tensor_span(8, 0, 8, 1) != 1) { return 1; } fi
  if (valid_tensor_span(8, 1, 3, 3) != 1) { return 2; } fi
  if (valid_tensor_span(8, 8, 0, 3) != 1) { return 3; } fi
  if (valid_tensor_span(0, 0, 0, 1) != 1) { return 4; } fi
  if (valid_tensor_span(9223372036854775807, 9223372036854775806, 1, 1) != 1) {
    return 5;
  } fi
  return 0;
}

fnc first_overflow_or_stride_failure(): int {
  if (valid_tensor_span(8, 7, 2, 1) != 0) { return 6; } fi
  if (valid_tensor_span(8, 8, 1, 1) != 0) { return 7; } fi
  if (valid_tensor_span(8, 1, 2, 0) != 0) { return 8; } fi
  if (valid_tensor_span(8, 1, 2, -2) != 0) { return 9; } fi
  if (valid_tensor_span(9223372036854775807, 1, 9223372036854775807, 2) != 0) {
    return 10;
  } fi
  return 0;
}

fnc first_range_failure(): int {
  if (valid_tensor_span(-1, 0, 0, 1) != 0) { return 11; } fi
  if (valid_tensor_span(8, -1, 1, 1) != 0) { return 12; } fi
  if (valid_tensor_span(8, 0, -1, 1) != 0) { return 13; } fi
  if (valid_tensor_span(8, 9, 0, 1) != 0) { return 14; } fi
  if (valid_tensor_span(8, 0, 3, 4) != 0) { return 15; } fi
  return 0;
}

pub fnc main(): int {
  let int positive = first_positive_failure();
  let int overflow = first_overflow_or_stride_failure();
  let int range = first_range_failure();
  if (positive != 0) { return positive; } fi
  if (overflow != 0) { return overflow; } fi
  if (range != 0) { return range; } fi
  return 42;
}
