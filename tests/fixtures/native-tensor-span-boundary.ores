// Independent Oreslang-source guest for strided tensor-view bounds.
// An integer metadata predicate is not an owned buffer or actor/device loan.
// Mirrors the source-level logic in Java backend stdlib/tensor.ores.
// Exit 42 only if all positive AND negative cases execute as expected.
fnc valid_tensor_span(int backing_elements, int start_element,
                      int element_count, int element_stride): int {
  if (backing_elements < 0) { return 0; } fi
  if (start_element < 0) { return 0; } fi
  if (element_count < 0) { return 0; } fi
  if (element_stride <= 0) { return 0; } fi
  if (start_element > backing_elements) { return 0; } fi
  if (element_count == 0) { return 1; } fi
  if (start_element == backing_elements) { return 0; } fi
  if (element_count - 1 > rt div_trunc_checked(backing_elements - 1 - start_element, element_stride)) {
    return 0;
  } fi
  return 1;
}

// One final result avoids the native guarded-return budget while checking
// every vector in compiled source. These checks must not be constant host tests.
pub fnc main(): int {
  return (
    valid_tensor_span(8, 0, 8, 1) == 1 &&
    valid_tensor_span(8, 1, 3, 3) == 1 &&
    valid_tensor_span(8, 8, 0, 3) == 1 &&
    valid_tensor_span(0, 0, 0, 1) == 1 &&
    valid_tensor_span(9223372036854775807, 9223372036854775806, 1, 1) == 1 &&
    valid_tensor_span(8, 7, 2, 1) == 0 &&
    valid_tensor_span(8, 8, 1, 1) == 0 &&
    valid_tensor_span(8, 1, 2, 0) == 0 &&
    valid_tensor_span(8, 1, 2, -2) == 0 &&
    valid_tensor_span(9223372036854775807, 1, 9223372036854775807, 2) == 0 &&
    valid_tensor_span(-1, 0, 0, 1) == 0 &&
    valid_tensor_span(8, -1, 1, 1) == 0 &&
    valid_tensor_span(8, 0, -1, 1) == 0 &&
    valid_tensor_span(8, 9, 0, 1) == 0 &&
    valid_tensor_span(8, 0, 3, 4) == 0
  ) ? 42 : 1;
}
