// Restricted AttoLang GPU source-to-OpenCL v1 compiler acceptance fixture.
// Compiles to an OpenCL kernel artifact, NOT executable .atto or device dispatch.
compute fnc saxpy(
  x: DeviceRead<f32>,
  y: DeviceRead<f32>,
  out: DeviceWrite<f32>,
  alpha: f32,
  n: u64
) device {
  const i = gpu.global_id.x;
  if i < n {
    out[i] = alpha * x[i] + y[i];
  }
}
