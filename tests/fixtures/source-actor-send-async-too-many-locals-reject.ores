define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  const int v0 = 0;
  const int v1 = 1;
  const int v2 = 2;
  const int v3 = 3;
  const int v4 = 4;
  const int v5 = 5;
  const int v6 = 6;
  const int v7 = 7;
  const int v8 = 8;
  const int v9 = 9;
  const int v10 = 10;
  const int v11 = 11;
  const int v12 = 12;
  const int v13 = 13;
  const int v14 = 14;
  const int v15 = 15;
  const int v16 = 16;
  await worker.send_async(1);
  stop worker;
  return v0;
}
