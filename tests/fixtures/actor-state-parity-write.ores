define actor Counter as
    state { value: int = 7; }
    increment(): int with state.read, state.write {
        return self.handle_state(critical |s| -> {
            s.value = s.value + 1;
            return s.value;
        });
    }
    increment_using(): int with state.read, state.write {
        return using state.write(critical |s| -> {
            s.value = s.value + 1;
            return s.value;
        });
    }
end
