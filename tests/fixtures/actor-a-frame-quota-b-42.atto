// Real native AOT guest: static actor policy bounds logical frames.
// Actor A permits zero receiver frames: its first handler frame admission
// fails locally and must produce supervisor PANIC, not an i64 success=0.
// Actor B has the default budget and must independently return 42.
@ActorFrameBudget(0) define actor QuotaActor as {
  let count: int = 0;
  pub fnc on_message(int n): int {
    count = count + n;
    return count;
  }
}
define actor HealthyActor as {
  let count: int = 0;
  pub fnc on_message(int n): int {
    count = count + n;
    return count;
  }
}
pub fnc main(): int {
  const a: ActorRef<QuotaActor> = spawn QuotaActor();
  const b: ActorRef<HealthyActor> = spawn HealthyActor();
  a.send(7);
  b.send(42);
  stop a;
  stop b;
  return 42;
}
