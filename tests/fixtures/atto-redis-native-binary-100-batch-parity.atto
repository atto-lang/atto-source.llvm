// Up to 100 concurrently owned NIO2 TCP sessions. One Atto actor is
// the sole mutable KV owner; a single broker consumes its output stream.
// Exactly one finite actor-mail batch per client can be in flight.
// This fixture is bounded to 100 total accepts for deterministic CI cleanup.
// Bounded request Channel capacity 32; reply Channel capacity 1/client.
// It does not implement a shared-memory arena or transfer raw pointers.
// Native Atto: one mailbox message executes one finite 1..16-command batch.
// Every Redis key/value stays inside this actor's Map<Bytes,Bytes>.
// Guest TCP sockets remain affine to the owning session Task.
define actor TaggedBatchKvActor implements StreamOperator<Tuple[int, int, List<Tuple[int, Bytes, Bytes]>], Tuple[int, int, List<Tuple[string, Bytes]>]> as
  let Map<Bytes,Bytes> values;

  on_start(): void {
    self.values = ~map<Bytes,Bytes>();
    return;
  }

  receive(ActorMail<Tuple[int, int, List<Tuple[int, Bytes, Bytes]>]> mail): void {
    const Tuple[int, int, List<Tuple[int, Bytes, Bytes]>] request = mail.value;
    const int client_id = request[0];
    const int batch_id = request[1];
    const List<Tuple[int, Bytes, Bytes]> commands = request[2];
    let mut List<Tuple[string, Bytes]> results = [];
    if client_id == 0 && batch_id == 0 && commands.size == 0; do
      self.send((0, 0, results));
      self.end();
      return;
    fi
    let int i = 0;
    loop {
      if i == commands.size then break; fi
      const Tuple[int, Bytes, Bytes] command = commands.get(i);
      const int kind = command[0];
      const Bytes key = command[1];
      const Bytes value = command[2];
      if kind == 1; do
        results.add(("PONG", value));
      elseif kind == 3; do
        self.values.set(key, value);
        results.add(("OK", value));
      elseif kind == 2; do
        val found = self.values.get_optional(key);
        if found.is_none(); do
          results.add(("NIL", value));
        else
          results.add(("VALUE", found.unwrap()));
        fi
      elseif kind == 4; do
        if self.values.delete(key); do
          results.add(("ONE", value));
        else
          results.add(("ZERO", value));
        fi
      else
        results.add(("ERR", value));
      fi
      i = i + 1;
    }
    // A complete command batch is one serialized actor turn.
    self.send((client_id, batch_id, results));
    return;
  }
end

// Only this task owns socket. It forwards a finite OWNED List through the
// bounded Channel, then checks the matching per-client batch reply sequence.
// No mutable borrow, socket pointer or raw address crosses any mailbox.
pub async fnc serve_tagged_batch_session(
    NioConnection socket,
    int client_id,
    Channel<Tuple[int, int, List<Tuple[int, Bytes, Bytes]>]> requests,
    Channel<Tuple[int, List<Tuple[string, Bytes]>]> replies
): void {
  let int next_batch_id = 0;
  try {
    loop {
      let mut List<Tuple[int, string, Bytes, Bytes]> frames = [];
      // Treat only failed NIO read completion as a normal disconnected peer.
      try {
        frames = await socket.read_resp2_binary_batch_async(16);
      } catch (read_error) {
        return;
      }
      if frames.size == 0 then return; fi
      let mut List<Tuple[int, Bytes, Bytes]> commands = [];
      let int terminate = 0;
      let int i = 0;
      loop {
        if i == frames.size then break; fi
        const Tuple[int, string, Bytes, Bytes] frame = frames.get(i);
        const int kind = frame[0];
        if kind == 0; do
          terminate = 1;
          break;
        fi
        if kind == 5; do
          terminate = 2;
          break;
        fi
        commands.add((kind, frame[2], frame[3]));
        i = i + 1;
      }

      if commands.size > 0; do
        // Move-only data is never inspected after channel admission.
        const int expected_replies = commands.size;
        next_batch_id = next_batch_id + 1;
        writech requests, (client_id, next_batch_id, commands);
        const Tuple[int, List<Tuple[string, Bytes]>] answer = await (nb readch replies);
        if answer[0] != next_batch_id || answer[1].size != expected_replies; do
          // Mismatched generation/sequence/cardinality cannot reach the wire.
          return;
        fi
        await socket.write_resp2_binary_batch_async(answer[1]);
      fi

      if terminate != 0; do
        if terminate == 2; do
          const Tuple[int, string, Bytes, Bytes] quit_frame = frames.get(i);
          await socket.write_resp2_binary_async("OK", quit_frame[3]);
        fi
        return;
      fi
    }
  } finally {
    // One retirement notice on QUIT, EOF or failure. Socket never shared.
    await socket.close_async();
    let mut List<Tuple[int, Bytes, Bytes]> retirement = [];
    writech requests, (client_id, -1, retirement);
  }
}

