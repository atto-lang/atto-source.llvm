define actor DurableRecovery as
  state {
    recovered_value: int = 0;
    result: int = 0;
  }

  pub fnc on_message(int fd): int with state.read, state.write, io, block {
    return self.handle_state(critical |s| -> {
      val recovered: int = 0;
      const read_ok: int = rt file_read_i64_blocking(fd, 0, rt borrow mut recovered);
      if (read_ok eq 1) {
        s.recovered_value = recovered;
        s.result = 1;
      } else {
        s.result = -1;
      } fi
      return s.result;
    });
  }
end
