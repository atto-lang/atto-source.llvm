define class Box as
  let int value = 40;
  read(): int { return self.value; }
  pub answer(): int {
    if true then
      let int read = 3;
      if true then
        return read() + 2;
      else
        return self.read() + 2;
      fi
    else
      return self.read() + 2;
    fi
  }
end
pub fnc main(): int {
