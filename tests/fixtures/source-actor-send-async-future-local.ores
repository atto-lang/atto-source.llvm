// Eager Future submission precedes local initialization; the local is copied
// into the runtime-owned detached frame only at await handoff.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  const Future<void> pending = worker.send_async(1);
  const int retained = 40;
  await pending;
  worker.send(2);
  stop worker;
  return retained + 3;
}
