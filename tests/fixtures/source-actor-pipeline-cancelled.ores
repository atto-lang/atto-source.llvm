// Two-actor minimum: 5 downstream, 19 backward, 24 total.
define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeMessages as
    Signal.Data
    Signal.Result
end
define actor Source<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = state.value + n; return state.value; });
                self.forward(Signal.Data(next));
            }
            on Signal.Result as n { value = value + n; }
        }
        return next;
    }
end
define actor Sink<messages=PipeMessages> as
    state { value: int = 0; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 14; return state.value; });
                self.backward(Signal.Result(next));
            }
            on Signal.Result as n { value = n; }
        }
        return next;
    }
end
pub fnc main(): int {
    const source = spawn Source();
    const sink = spawn Sink();
    pipeline(source, sink);
    cancel_pipeline(source);
    source.send(Signal.Data(5));
    expect_pipeline(source, 24);
    stop sink;
    stop source;
    return 43;
}
