// Every printed value is pinned byte-for-byte against the Java backend.
fnc half(float x): float { return x / 2; }
fnc from_int(int x): float { return x; }

pub define class Mixed as
  pub val float a;
  pub val int n;
  pub val bool b;
end

fnc make(float a): Mixed { return new Mixed(a * 2, 3, a > 1); }
fnc total(borrow Mixed m): float { return m.a + m.n; }

pub routine main(): void {
  stdio.stdout.println(0.1 + 0.2);
  stdio.stdout.println(0.0 / 0.0);
  stdio.stdout.println(1.0 / 0.0);
  stdio.stdout.println(-1.0 / 0.0);
  stdio.stdout.println(-0.0);
  stdio.stdout.println(1.0e10);
  stdio.stdout.println(1.0e-5);
  stdio.stdout.println(3.0);
  stdio.stdout.println(0.0 == -0.0);
  stdio.stdout.println(1 / 2);
  stdio.stdout.println(4 / 2);
  stdio.stdout.println(1 / 0);
  stdio.stdout.println(1 + 2.5);
  stdio.stdout.println(2 == 2.0);
  stdio.stdout.println(2 != 2.5);
  stdio.stdout.println(2 < 2.5);
  stdio.stdout.println(1.0e7);
  stdio.stdout.println(1234567.5);
  stdio.stdout.println(0.001);
  stdio.stdout.println(0.00099);
  stdio.stdout.println(100.0);
  stdio.stdout.println(1.0e21);
  stdio.stdout.println(4.9e-324);
  stdio.stdout.println(1.7976931348623157e308);
  stdio.stdout.println(2.0e23);
  stdio.stdout.println(1_000.5);
  stdio.stdout.println(1.0e400);
  stdio.stdout.println(1.0e-400);
  stdio.stdout.println(half(5));
  stdio.stdout.println(from_int(7) / 2);
  stdio.stdout.println(false ? 1 : 2.5);
  stdio.stdout.println(9007199254740993 == 9007199254740992.0);
  stdio.stdout.println(9007199254740992 == 9007199254740992.0);

  val Mixed m = make(1.5);
  stdio.stdout.println(m.a);
  stdio.stdout.println(m.n);
  stdio.stdout.println(m.b);
  stdio.stdout.println(total(rt borrow m));

  let Mixed q = new Mixed(0.25, 1, false);
  for let i = 0; i < 3; i++ do
    q = make(q.a + i);
  done
  stdio.stdout.println(q.a);

  let float acc = 0;
  let int i = 0;
  while i < 10 do
    i = i + 1;
    if i == 2 then continue; fi
    if i == 8 then break; fi
    val float t = i / 4;
    acc = acc + t;
  done
  stdio.stdout.println(acc);

  stdio.stdout.write("w=");
  stdio.stdout.write(1);
  stdio.stdout.write(true);
  stdio.stdout.write(2.5);
  stdio.stdout.println("");
}
