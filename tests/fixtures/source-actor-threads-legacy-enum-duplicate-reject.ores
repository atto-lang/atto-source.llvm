define enum MaxActorThreads as
    LOW int = 1
    MEDIUM int = 2
    HIGH int = 3
end

define enum MaxActorThreads as
    LOW int = 1
    MEDIUM int = 2
    HIGH int = 3
end

// Two fire-and-forget guest messages; stop drains the bounded FIFO.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  worker.send(1);
  worker.send(2);
  stop worker;
  return 43;
}
