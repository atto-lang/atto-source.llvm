// Both spellings select on_message/1, so the second declaration must fail.
define actor Worker as {
  const base: int = 40;
  let total: int = 0;
  pub method on_message(self, int n): int { return base + n; }
  pub on_message(int n): int { return base + n; }
}
pub fnc main(): int {
  const worker = spawn Worker();
  stop worker;
  return 43;
}
