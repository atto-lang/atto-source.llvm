define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int throws ActorTerminated {
  const worker: ActorRef<Worker> = spawn Worker();
  await worker;
  await worker.get_ready();
  stop worker;
  await worker.get_done();
  await worker.get_done();
  return 43;
}
