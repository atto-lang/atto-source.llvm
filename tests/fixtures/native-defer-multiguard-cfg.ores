define class Counter as
  pub let int value = 1;
end
fnc multiply_two(borrow mut Counter c): void {
  c.value = c.value * 2;
  return;
}
fnc add_one(borrow mut Counter c): void {
  c.value = c.value + 1;
  return;
}
fnc tick(borrow mut Counter c, int guard): int {
  defer add_one(rt mut borrow c);
  defer multiply_two(rt mut borrow c);
  if (guard eq 0) { return 0; } fi
  if (guard eq 1) { return 1; } fi
  return 2;
}
pub fnc main(): int {
  let mut Counter c = new Counter();
  tick(rt mut borrow c, 0);
  tick(rt mut borrow c, 1);
  tick(rt mut borrow c, 2);
  return c.value;
}
