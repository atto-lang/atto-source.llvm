// A routine is direct-call-only and must never join recursive cycles.
// Do not erase it into an fnc when compiling the actor's M3 call graph.
routine bounce(int n): int {
  if n <= 0 then
    return 0;
  fi
  return bounce(n - 1);
}
define actor Worker as {
  let seen: int = 0;
  pub fnc on_message(int n): int {
    return bounce(n);
  }
}
pub fnc main(): int {
  const a: ActorRef<Worker> = spawn Worker();
  stop a;
  return 43;
}
