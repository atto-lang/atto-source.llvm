define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  await readable(0) as ReadableOutcome outcome;
  worker.send(1);
  stop worker;
  return outcome == ReadableOutcome.Ready ? 43 :
         outcome == ReadableOutcome.Cancelled ? 44 : 45;
}
