// Boundary and rejection audit. All operations are called on the Oreslang queue.
import class IntLinkedQueue from "../src/int_linked_queue";

pub routine main() -> int {
  val IntLinkedQueue zero = new IntLinkedQueue(0);
  if zero.initialize() then
    return 1;
  fi
  if zero.validate() then
    return 2;
  fi
  if zero.enqueue(0, 7) then
    return 3;
  fi
  if zero.dequeue().is_some() then
    return 4;
  fi

  val IntLinkedQueue negative = new IntLinkedQueue(-1);
  if negative.initialize() then
    return 5;
  fi

  val IntLinkedQueue oversized = new IntLinkedQueue(65537);
  if oversized.initialize() then
    return 6;
  fi

  val IntLinkedQueue q = new IntLinkedQueue(3);
  if q.enqueue(0, 100) then
    return 7;
  fi
  if q.validate() then
    return 8;
  fi
  if !q.initialize() then
    return 9;
  fi
  if !q.enqueue(0, 100) then
    return 10;
  fi
  if !q.insert_before(0, 1, 200) then
    return 11;
  fi
  if !q.insert_after(0, 2, 300) then
    return 12;
  fi
  if !q.validate() then
    return 13;
  fi
  if q.first().unwrap().key != 1 then
    return 14;
  fi
  if q.last().unwrap().key != 2 then
    return 15;
  fi

  // Rejected mutation must not affect the active node chain or payloads.
  if q.initialize() then
    return 16;
  fi
  if q.enqueue(1, 999) then
    return 17;
  fi
  if q.insert_before(2, 1, 999) then
    return 18;
  fi
  if q.insert_after(1, 0, 999) then
    return 19;
  fi
  if q.remove(-1).is_some() then
    return 20;
  fi
  if q.remove(3).is_some() then
    return 21;
  fi
  if q.get(3).is_some() then
    return 22;
  fi
  if !q.validate() then
    return 23;
  fi
  if q.size() != 3 then
    return 24;
  fi

  // Snapshot is not an owned reference to the live node.
  val removed = q.remove(0).unwrap();
  if removed.value != 100 then
    return 25;
  fi
  if !q.enqueue(0, -100) then
    return 26;
  fi
  if removed.value != 100 then
    return 27;
  fi
  if q.get(0).unwrap() != -100 then
    return 28;
  fi
  if !q.validate() then
    return 29;
  fi

  q.clear();
  q.clear();
  if !q.is_empty() then
    return 30;
  fi
  if !q.validate() then
    return 31;
  fi
  return 0;
}
