// Relink boundary matrix; run using the actual Oreslang compiler.
import class IntLinkedQueue from "../src/int_linked_queue";

pub routine main() -> int {
  val IntLinkedQueue one = new IntLinkedQueue(1);
  if !one.initialize() then
    return 1;
  fi
  if !one.enqueue(0, 0) then
    return 2;
  fi
  if one.enqueue(0, 99) then
    return 3;
  fi
  if !one.validate() then
    return 4;
  fi
  if one.remove_last().unwrap().value != 0 then
    return 5;
  fi
  if !one.add_to_front(0, -1) then
    return 6;
  fi
  if one.dequeue().unwrap().value != -1 then
    return 7;
  fi
  if !one.validate() then
    return 8;
  fi

  val IntLinkedQueue q = new IntLinkedQueue(3);
  if !q.initialize() then
    return 9;
  fi
  if !q.enqueue(0, 100) then
    return 10;
  fi
  if !q.insert_after(0, 1, 200) then
    return 11;
  fi
  if !q.insert_before(0, 2, 300) then
    return 12;
  fi
  if !q.validate() then
    return 13;
  fi
  // Order is 2, 0, 1.
  if q.ordered_keys().get(0) != 2 then
    return 14;
  fi
  if q.ordered_keys().get(1) != 0 then
    return 15;
  fi
  if q.ordered_keys().get(2) != 1 then
    return 16;
  fi
  if q.insert_before(0, 1, 999) then
    return 17;
  fi
  if q.remove(0).unwrap().value != 100 then
    return 18;
  fi
  if !q.validate() then
    return 19;
  fi
  if !q.insert_before(1, 0, -100) then
    return 20;
  fi
  if !q.validate() then
    return 21;
  fi
  if q.remove(2).unwrap().value != 300 then
    return 22;
  fi
  if !q.validate() then
    return 23;
  fi
  if q.dequeue().unwrap().value != -100 then
    return 24;
  fi
  if q.remove_last().unwrap().value != 200 then
    return 25;
  fi
  if !q.is_empty() then
    return 26;
  fi
  if !q.validate() then
    return 27;
  fi
  if q.get(0).is_some() then
    return 28;
  fi
  if !q.enqueue(2, -300) then
    return 29;
  fi
  if !q.validate() then
    return 30;
  fi
  q.clear();
  if !q.validate() then
    return 31;
  fi
  return 0;
}
