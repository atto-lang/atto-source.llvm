define actor ReleaseAuthority as
  state {
    revision: int = 9;
    leader_epoch: int = 7;
    lease_current: int = 1;
    reservation_present: int = 1;
    terminated: int = 1;
    fenced: int = 1;
    receipt_epoch: int = 7;
    receipt_consumed: int = 0;
    cpu_reserved: int = 900;
    cpu_reservation: int = 500;
    mem_reserved: int = 2048;
    mem_reservation: int = 1024;
    result: int = 0;
  }
  pub fnc on_message(int verified_receipt_epoch): int with state.read, state.write {
    return self.handle_state(critical |s| -> {
      if (s.lease_current != 1) {
        s.result = -1;
      } else {
        if (verified_receipt_epoch != s.leader_epoch) {
          s.result = -2;
        } else {
          if (s.receipt_epoch != s.leader_epoch) {
            s.result = -3;
          } else {
            if (s.receipt_consumed != 0) {
              s.result = -4;
            } else {
              if (s.reservation_present != 1) {
                s.result = -5;
              } else {
                if (s.terminated != 1) {
                  s.result = -6;
                } else {
                  if (s.fenced != 1) {
                    s.result = -7;
                  } else {
                    if (s.cpu_reservation <= 0) {
                      s.result = -8;
                    } else {
                      if (s.cpu_reserved < s.cpu_reservation) {
                        s.result = -9;
                      } else {
                        if (s.mem_reservation <= 0) {
                          s.result = -10;
                        } else {
                          if (s.mem_reserved < s.mem_reservation) {
                            s.result = -11;
                          } else {
                            s.cpu_reserved = s.cpu_reserved - s.cpu_reservation;
                            s.mem_reserved = s.mem_reserved - s.mem_reservation;
                            s.reservation_present = 0;
                            s.receipt_consumed = 1;
                            s.revision = s.revision + 1;
                            s.result = 1;
                          } fi
                        } fi
                      } fi
                    } fi
                  } fi
                } fi
              } fi
            } fi
          } fi
        } fi
      } fi
      return s.result;
    });
  }
end
