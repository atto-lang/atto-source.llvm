// Scalar alias resolution must be independent of source declaration order.
// Transparent scalar aliases must resolve before backend ABI admission.
fnc identity(Code value): Code { return value; }
fnc ready(Flag value): Flag { return value; }

define type Code = Raw;
define type Raw = int;
define type Flag = bool;

pub fnc main(): int {
  return ready(true) ? identity(7) : 0;
}
