define class Probe as
    pub final int status: 42;
    pub final int ready: 1;
end
pub fnc main(): int {
    const Probe owned = new Probe();
    return match<int> owned over
        on structural ~(status: 42) -> { 42; }
        on structural ~(ready: 1) -> { 1; }
        default -> { 0; }
    end;
}
