fnc helper(): string {
  return "ready cleanup";
}

define class CleanupRecord as
  pub final int token: 1;
end

fnc record_helper() -> CleanupRecord {
  return new CleanupRecord();
}

define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}

pub fnc main(): int throws ActorTerminated {
  const worker: ActorRef<Worker> = spawn Worker();
  await worker.get_ready();
  stop worker;
  return 43;
}
