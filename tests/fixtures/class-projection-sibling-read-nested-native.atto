define class Pair as
  pub let int left = 20;
  pub let int right = 22;
end
fnc twice(int x): int { return x + x; }
fnc inspect(borrow mut int a, int b): int { return a + b - 22; }
pub fnc main(): int {
  let mut Pair pair = new Pair();
  return inspect(rt mut borrow pair.left, twice(pair.right));
}
