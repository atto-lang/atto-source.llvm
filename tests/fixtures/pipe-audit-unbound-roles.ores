define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeForwardMessages as Signal.Data end
define match pattern PipeBackwardMessages as Signal.Result end

define source pipe actor Stage0<forward_messages=PipeForwardMessages,backward_messages=PipeBackwardMessages> as
    state { value: int = 0; }
    receive_forward(PipeForwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });

            }
        }
        return;
    }
    receive_backward(PipeBackwardMessages m): void with state.read, state.write {
        do match m over {
            on Signal.Result as n {
                const next = self.handle_state(critical |state| -> { state.value = n + 1; return state.value; });

            }
        }
        return;
    }
end
