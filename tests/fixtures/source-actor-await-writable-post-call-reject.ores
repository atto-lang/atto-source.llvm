pub fnc ping(): int {
  return 1;
}

define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}

pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  await writable(1);
  ping();
  stop worker;
  return 43;
}
