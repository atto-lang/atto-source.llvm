define class Buckets as
  pub let int bound;
  pub let mut Array<int> heads = new Array<int>();
  pub constructor(int capacity) {
    if capacity < 1 || capacity > 16; do
      rt fail("capacity outside 1..16");
    fi
    self.bound = capacity;
    for (let int i = 0; i < capacity; i = i + 1) {
      self.heads.add(-1);
    }
  }
end
fnc make_buckets(int capacity): Buckets {
  let mut Buckets b = new Buckets(capacity);
  return b;
}
pub fnc main(): int {
  let mut Buckets first = rt take make_buckets(1);
  if first.bound neq 1 || first.heads.get(0) neq -1; do return 1; fi
  let mut Buckets second = rt take make_buckets(16);
  if second.bound neq 16 || second.heads.size neq 16 || second.heads.get(15) neq -1; do return 2; fi
  second.heads.set(15, 42);
  return second.heads.get(15);
}
