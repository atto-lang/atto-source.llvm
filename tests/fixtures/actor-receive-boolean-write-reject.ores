define enum Signal as
    Data: int = 1
end
define match pattern PipeMessages as
    Signal.Data
end
define actor Probe<messages=PipeMessages> as
    state { value: int = 1; }
    receive(PipeMessages m) with state.write {
        do match m over {
            on Signal.Data as n {
                const next = using state.write(critical |s| -> {
                    s.value = true;
                    return 10;
                });
            }
        }
        return 0;
    }
end
