// Compiler-executed scalar rank-2 tensor preflight.
// Deliberately uses the LLVM-supported native function/guard subset.
// No host C++ admission helper, actor/stdlib linker or GPU is called.
// Numerical vectors mirror Java PR #2227; not identical source AST yet.
fnc axis_span(int length, int stride): int {
  if (length < 0) { return -1; } fi
  if (stride < 0) { return -1; } fi
  if (length < 2) { return 0; } fi
  if (stride > 9223372036854775807 / (length - 1)) { return -1; } fi
  return (length - 1) * stride;
}

fnc readonly_view(int rows, int cols, int row_stride, int col_stride, int bytes, int capacity): int {
  if (rows < 0) { return 0; } fi
  if (cols < 0) { return 0; } fi
  if (row_stride < 0) { return 0; } fi
  if (col_stride < 0) { return 0; } fi
  if (bytes <= 0) { return 0; } fi
  if (capacity < 0) { return 0; } fi
  if (rows == 0) { return 1; } fi
  if (cols == 0) { return 1; } fi
  let int row_span = axis_span(rows, row_stride);
  let int col_span = axis_span(cols, col_stride);
  if (row_span < 0) { return 0; } fi
  if (col_span < 0) { return 0; } fi
  if (row_span > 9223372036854775807 - col_span) { return 0; } fi
  let int last_index = row_span + col_span;
  if (last_index == 9223372036854775807) { return 0; } fi
  let int elements = last_index + 1;
  if (bytes > 9223372036854775807 / elements) { return 0; } fi
  if (elements * bytes > capacity) { return 0; } fi
  return 1;
}

fnc axis_is_aliased(int length, int stride): int {
  if (length <= 1) { return 0; } fi
  if (stride == 0) { return 1; } fi
  return 0;
}

fnc writable_rows_safe(int rows, int cols, int row_stride, int col_stride): int {
  if (rows <= 1) { return 1; } fi
  if (cols <= 1) { return 1; } fi
  if (col_stride > 9223372036854775807 / cols) { return 0; } fi
  if (row_stride < cols * col_stride) { return 0; } fi
  return 1;
}

fnc writable_view(int rows, int cols, int row_stride, int col_stride, int bytes, int capacity): int {
  if (readonly_view(rows, cols, row_stride, col_stride, bytes, capacity) == 0) { return 0; } fi
  if (rows == 0) { return 1; } fi
  if (cols == 0) { return 1; } fi
  if (axis_is_aliased(rows, row_stride) == 1) { return 0; } fi
  if (axis_is_aliased(cols, col_stride) == 1) { return 0; } fi
  return writable_rows_safe(rows, cols, row_stride, col_stride);
}

fnc exact_contiguous(int rows, int cols, int row_stride, int col_stride, int bytes, int capacity): int {
  if (readonly_view(rows, cols, row_stride, col_stride, bytes, capacity) == 0) { return 0; } fi
  if (col_stride != 1) { return 0; } fi
  if (row_stride != cols) { return 0; } fi
  if (rows == 0) { return is_zero(capacity); } fi
  if (cols == 0) { return is_zero(capacity); } fi
  if (rows > 9223372036854775807 / cols) { return 0; } fi
  let int elements = rows * cols;
  if (bytes > 9223372036854775807 / elements) { return 0; } fi
  if (elements * bytes != capacity) { return 0; } fi
  return 1;
}

fnc is_zero(int value): int {
  if (value == 0) { return 1; } fi
  return 0;
}

fnc compatible_axis(int a, int b): int {
  if (a < 0) { return 0; } fi
  if (b < 0) { return 0; } fi
  if (a == b) { return 1; } fi
  if (a == 1) { return 1; } fi
  if (b == 1) { return 1; } fi
  return 0;
}

pub fnc main(): int {
  if (writable_view(3,4,4,1,8,96) != 1) { return 1; } fi
  if (exact_contiguous(3,4,4,1,8,96) != 1) { return 2; } fi
  if (writable_view(3,4,8,1,4,80) != 1) { return 3; } fi
  if (exact_contiguous(3,4,8,1,4,80) != 0) { return 4; } fi
  if (readonly_view(3,4,0,0,8,8) != 1) { return 5; } fi
  if (writable_view(3,4,0,0,8,8) != 0) { return 6; } fi
  if (writable_view(2,2,1,1,8,24) != 0) { return 7; } fi
  if (writable_view(3,4,4,1,8,95) != 0) { return 8; } fi
  if (writable_view(9223372036854775807,3,2,1,8,96) != 0) { return 9; } fi
  if (exact_contiguous(0,4,4,1,8,0) != 1) { return 10; } fi
  if (writable_view(-1,4,4,1,8,96) != 0) { return 11; } fi
  if (compatible_axis(3,1) != 1) { return 12; } fi
  if (compatible_axis(1,4) != 1) { return 13; } fi
  if (compatible_axis(0,1) != 1) { return 14; } fi
  if (compatible_axis(3,5) != 0) { return 15; } fi
  if (readonly_view(2,1,9223372036854775807,0,1,9223372036854775807) != 0) { return 16; } fi
  if (writable_view(1,1,0,0,9223372036854775807,9223372036854775807) != 1) { return 17; } fi
  return 42;
}
