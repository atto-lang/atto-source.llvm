// First executable native source select slice: nonblocking send admission
// versus explicit default. The send arm should win with fresh mailbox credit.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}

pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  let chosen: int = 0;
  try select {
    when worker.send_async(1): -> {
      chosen = 43;
    }
    default -> {
      chosen = 42;
    }
  }
  stop worker;
  return chosen;
}
