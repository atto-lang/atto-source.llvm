// Executed, non-network Atto/LLVM AMQP 0-9-1 preface predicate.
// Source-level eight-octet predicate, NOT a TCP listener or AMQP broker.
// Checked i64 comparisons and boolean operators; no allocations or FFI.
pub fnc valid_amqp_preface(int p0, int p1, int p2, int p3,
                            int p4, int p5, int p6, int p7): bool {
  return p0 == 65 && p1 == 77 && p2 == 81 && p3 == 80 &&
         p4 == 0 && p5 == 0 && p6 == 9 && p7 == 1;
}
pub fnc main(): int {
  return valid_amqp_preface(65, 77, 81, 80, 0, 0, 9, 1) &&
         !valid_amqp_preface(65, 77, 81, 80, 0, 0, 9, 2) &&
         !valid_amqp_preface(65, 77, 81, 80, 0, 1, 9, 1) &&
         !valid_amqp_preface(65, 77, 81, 79, 0, 0, 9, 1) &&
         !valid_amqp_preface(65, 77, 81, 80, 0, 0, 9, 256) &&
         !valid_amqp_preface(-1, 77, 81, 80, 0, 0, 9, 1) ? 43 : 1;
}
