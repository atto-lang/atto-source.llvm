define inverted struct Counter as
    let active: bool;
    let count: i64;
end

fnc main(): int {
    let rows = InvertedArray<Counter>.with_capacity(3);
    rows.push(false, 11);
    rows.push(true, 42);
    rows.set(0, active, true);
    rows.set(0, count, 42);
    rows.erase_swap(1);
    return rows.get(0, count);
}
