// Bool cannot be compared as f64 or used as main integer result.
define inverted struct Particle as
    let x: int;
    alive: bool;
    let energy: f64;
end
fnc main(): int {
    let rows = InvertedArray<Particle>.with_capacity(2);
    rows.push(7, true, 3.75);
    return rows.get(0, alive) == 3.75 ? 42 : 7;
}
