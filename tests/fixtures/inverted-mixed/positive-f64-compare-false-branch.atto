// Requires actual load + false-side selection, not constant return 42.
define inverted struct Particle as
    let x: int;
    alive: bool;
    let energy: f64;
end
fnc main(): int {
    let rows = InvertedArray<Particle>.with_capacity(2);
    rows.push(42, true, 1.5);
    rows.set(0, energy, 3.75);
    return rows.get(0, energy) == 1.5 ? 7 : 42;
}
