// The formal borrow parameter is #2 but appears first at the call site.
define class CallOrderOwner as
  pub let int value = 7;
end
fnc inspect(int value, borrow mut CallOrderOwner owner): int {
  return value;
}
pub fnc main(): int {
  let mut CallOrderOwner b = new CallOrderOwner();
  return inspect(owner: rt mut borrow b, value: 7);
}
