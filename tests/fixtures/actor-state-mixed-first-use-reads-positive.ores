define enum Signal as
    Data: int = 1
end
define match pattern PipeMessages as
    Signal.Data
end
define actor Probe<messages=PipeMessages> as
    state { first: int = 0; second: int = 7; }
    receive(PipeMessages m) with state.read, state.write {
        do match m over {
            on Signal.Data as n {
                const next = using state.write(critical |state| -> {
                    state.first = n;
                    state.second = state.first + state.second;
                    return state.second;
                });
            }
        }
        return 0;
    }
end
