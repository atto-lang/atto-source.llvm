// Actual .ores -> LLVM -> Clang signed-i64 quotient execution.
// Oreslang / is floating point; the explicit rt operation is exact signed i64.
pub fnc main(): int {
  return (
    rt div_trunc_checked(7, 3) == 2 &&
    rt div_trunc_checked(-7, 3) == -2 &&
    rt div_trunc_checked(7, -3) == -2 &&
    rt div_trunc_checked(-7, -3) == 2 &&
    rt div_trunc_checked(9223372036854775807, 9223372036854775807) == 1 &&
    rt div_trunc_checked(-9223372036854775808, 1) == -9223372036854775808 &&
    rt div_trunc_checked(-9223372036854775808, -2) == 4611686018427387904 &&
    rt div_trunc_checked(0, -2) == 0 &&
    rt div_trunc_checked(9223372036854775807, 3) == 3074457345618258602 &&
    rt div_trunc_checked(-9223372036854775808, 3) == -3074457345618258602
  ) ? 42 : 1;
}
