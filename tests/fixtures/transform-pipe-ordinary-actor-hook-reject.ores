define enum Signal as
    Data: int = 1
    Result: int = 2
end
define match pattern PipeForwardMessages as
    Signal.Data
end
define match pattern PipeBackwardMessages as
    Signal.Result
end
define actor Stage<messages=PipeForwardMessages> as
    let value: int = 0;
    receive_forward(PipeForwardMessages m): void {
        do match m over {
            on Signal.Data as n { value = n + 1; }
        }
        return;
    }
end
pub fnc main(): int { return 43; }
