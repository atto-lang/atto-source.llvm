// 100 non-tail recursive guest calls exceed this actor's 64-frame
// quota. The runtime must seal only this actor, never crash the carrier.
fnc depth(int n): int {
  if n <= 0 then
    return 0;
  fi
  return 1 + depth(n - 1);
}
define actor Worker as {
  let seen: int = 0;
  pub fnc on_message(int n): int {
    return depth(n);
  }
}
pub fnc main(): int {
  const a: ActorRef<Worker> = spawn Worker();
  a.send(100);
  stop a;
  return 43;
}
