// Native LLVM source-to-AOT actor: 4 Redis-like scalar commands per mail.
// This is actor-owned scalar state, NOT binary key/value Map or TCP.
// All 12 logical commands execute in 3 native mailbox receives.
//
// 1353 => SET7 GET7 PING GET7 => digest 107207401207
// 3435 => GET7 DEL1 GETnil PING => digest 207301200401
// 2343 => SET9 GET9 DEL1 GETnil => digest 109209301200
define actor NativeBatchedScalarRedis as {
  let stored: int = 0;
  let present: int = 0;
  let previously_present: int = 0;
  let digest: int = 0;
  let remaining: int = 0;
  let digit: int = 0;

  pub fnc on_message(int batch): int {
    remaining = batch;

    digit = remaining / 1000;
    remaining = remaining - digit * 1000;
    previously_present = present;
    stored = (digit eq 1) ? 7 : ((digit eq 2) ? 9 : stored);
    present = (digit eq 1) ? 1 :
      ((digit eq 2) ? 1 : ((digit eq 4) ? 0 : present));
    digest = ((digit eq 1) ? 107 :
      ((digit eq 2) ? 109 :
      ((digit eq 3) ? ((present eq 1) ? 200 + stored : 200) :
      ((digit eq 4) ? 300 + previously_present :
      ((digit eq 5) ? 401 : 0)))));

    digit = remaining / 100;
    remaining = remaining - digit * 100;
    previously_present = present;
    stored = (digit eq 1) ? 7 : ((digit eq 2) ? 9 : stored);
    present = (digit eq 1) ? 1 :
      ((digit eq 2) ? 1 : ((digit eq 4) ? 0 : present));
    digest = digest * 1000 + ((digit eq 1) ? 107 :
      ((digit eq 2) ? 109 :
      ((digit eq 3) ? ((present eq 1) ? 200 + stored : 200) :
      ((digit eq 4) ? 300 + previously_present :
      ((digit eq 5) ? 401 : 0)))));

    digit = remaining / 10;
    remaining = remaining - digit * 10;
    previously_present = present;
    stored = (digit eq 1) ? 7 : ((digit eq 2) ? 9 : stored);
    present = (digit eq 1) ? 1 :
      ((digit eq 2) ? 1 : ((digit eq 4) ? 0 : present));
    digest = digest * 1000 + ((digit eq 1) ? 107 :
      ((digit eq 2) ? 109 :
      ((digit eq 3) ? ((present eq 1) ? 200 + stored : 200) :
      ((digit eq 4) ? 300 + previously_present :
      ((digit eq 5) ? 401 : 0)))));

    digit = remaining / 1;
    remaining = remaining - digit * 1;
    previously_present = present;
    stored = (digit eq 1) ? 7 : ((digit eq 2) ? 9 : stored);
    present = (digit eq 1) ? 1 :
      ((digit eq 2) ? 1 : ((digit eq 4) ? 0 : present));
    digest = digest * 1000 + ((digit eq 1) ? 107 :
      ((digit eq 2) ? 109 :
      ((digit eq 3) ? ((present eq 1) ? 200 + stored : 200) :
      ((digit eq 4) ? 300 + previously_present :
      ((digit eq 5) ? 401 : 0)))));

    return digest;
  }
}

pub fnc main(): int {
  const worker = spawn NativeBatchedScalarRedis();
  await worker.get_ready();
  worker.send(1353);
  worker.send(3435);
  worker.send(2343);
  stop worker;
  return 43;
}
