// AttoLang LLVM: first source actor acquires a checked-in native carrier
// before its ActorRef is published; later idle actors reuse bounded workers.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  worker.send(1);
  worker.send(2);
  stop worker;
  return 43;
}
