define class Counter as
  pub let int value = 2;
end
fnc change(borrow mut Counter c): int {
  try {
    defer c.value = c.value + 3;
    defer c.value = c.value * 10;
    throw 7;
  } catch (err) {
    return c.value;
  } finally {
    c.value = c.value + 1;
  }
}
pub fnc main(): int {
  let mut Counter c = new Counter();
  val output: int = change(rt borrow mut c);
  return output + c.value;
}
