// Executed native guest regression: order-sensitive FIFO and drain-before-STOP.
// Rolling base-11 digest distinguishes permutations that share the same sum.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total * 11 + n;
    return total;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  worker.send(1);
  worker.send(2);
  worker.send(3);
  worker.send(4);
  worker.send(5);
  worker.send(6);
  worker.send(7);
  worker.send(8);
  worker.send(9);
  worker.send(10);
  stop worker;
  return 43;
}
