// Await unconditionally suspends: a synchronous actor method cannot await,
// even if some Future happens to be immediately ready at runtime.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int incoming): int {
    return await incoming;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  worker.send(1);
  stop worker;
  return 43;
}
