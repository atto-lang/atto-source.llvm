// Proposed exact-guest compilation vector (NOT YET EXECUTED).
import module heap from "atto.alloc/heap";
import module arena from "atto.alloc/arena";
import module region from "atto.alloc/region";
pub fnc main(): int {
  if heap.heap_reserved_total(10, 2, 4, 16) != 16 then return 1; fi
  if heap.heap_reserved_total(10, 2, 5, 16) != -1 then return 2; fi
  if heap.heap_after_release(11, 12) != -1 then return 3; fi
  if arena.arena_aligned_start(3, 4, 8, 16) != 8 then return 4; fi
  if arena.arena_end(3, 4, 8, 16) != 12 then return 5; fi
  if arena.arena_end(3, 9, 8, 16) != -1 then return 6; fi
  if arena.arena_end(3, 0, 8, 16) != 3 then return 7; fi
  if region.region_owner_matches(7, 3, 7, 4) then return 8; fi
  if region.region_can_destroy(true, true, 0, 1, 0, 0, 0, 0) then return 9; fi
  if region.region_can_destroy(false, true, 0, 0, 0, 0, 0, 0) then return 10; fi
  if !region.region_can_destroy(true, true, 0, 0, 0, 0, 0, 0) then return 11; fi
  return 42;
}
