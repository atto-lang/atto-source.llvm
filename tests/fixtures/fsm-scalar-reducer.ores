// Bounded scalar-only flat FSM reducer, intentionally not an FSM keyword.
// Does not implement version commits, effect outboxes, ECS or state loans.
// 0=idle, 1=running, 2=done; events 0=start,1=tick,2=finish,3=reset.
// -1=Rejected (distinct from accepted self-transition to state 1).
fnc tick_state(int ticks): int {
    if (ticks eq 0) { return 1; } fi
    if (ticks eq 1) { return 1; } fi
    if (ticks eq 2) { return 1; } fi
    return -1;
}
fnc finish_state(int ticks): int {
    if (ticks eq 2) { return 2; } fi
    if (ticks eq 3) { return 2; } fi
    return -1;
}
fnc bounded_ticks(int ticks): int {
    if (ticks eq 0) { return 1; } fi
    if (ticks eq 1) { return 1; } fi
    if (ticks eq 2) { return 1; } fi
    if (ticks eq 3) { return 1; } fi
    return 0;
}
fnc step_state(int state, int event, int ticks): int {
    if (bounded_ticks(ticks) eq 0) { return -1; } fi
    // Match both coordinates separately. Packing with state*10+event
    // aliases out-of-domain inputs (e.g. state 0, event 11 -> 1,1).
    if (state eq 0) {
        if (event eq 0) { return 1; } fi
        return -1;
    } fi
    if (state eq 1) {
        if (event eq 1) { return tick_state(ticks); } fi
        if (event eq 2) { return finish_state(ticks); } fi
        return -1;
    } fi
    if (state eq 2) {
        if (event eq 3) { return 0; } fi
        return -1;
    } fi
    return -1;
}
