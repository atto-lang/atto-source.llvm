pub fnc main(): int {
  return (
    (false && false) == false &&
    (false && true) == false &&
    (true && false) == false &&
    (true && true) == true &&
    (false || false) == false &&
    (false || true) == true &&
    (true || false) == true &&
    (true || true) == true &&
    Xor(false, false) == false &&
