// Two distinct native Atto actor-owned heaps, four admitted DATA messages.
// Immediate stop() cancels queued DATA, so require explicit graceful_stop()
// which seals new sends, drains accepted work and joins physical termination.
// This is transitional inline on_message, not multi-file declare actor.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const a: ActorRef<Worker> = spawn Worker();
  const b: ActorRef<Worker> = spawn Worker();
  a.send(1);
  b.send(5);
  a.send(2);
  b.send(6);
  a.graceful_stop();
  b.graceful_stop();
  return 43;
}
