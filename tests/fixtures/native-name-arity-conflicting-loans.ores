// An arity-2 overload must not accidentally use the arity-1 borrow signature.
fnc inspect(borrow int x): int { return x; }
fnc inspect(borrow mut int x, borrow int y): int { return x + y; }
fnc wrapper(int x): int { return inspect(rt borrow mut x, rt borrow x); }
pub fnc main(): int { return wrapper(41); }
