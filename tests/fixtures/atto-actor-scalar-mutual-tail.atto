// Closed mutual recursion must transfer between actor-owned typed
// frames without ever recursively invoking the carrier's C/LLVM stack.
fnc even(int n): int {
  if n <= 0 then
    return 1;
  fi
  return odd(n - 1);
}
fnc odd(int n): int {
  if n <= 0 then
    return 0;
  fi
  return even(n - 1);
}
define actor Worker as {
  let seen: int = 0;
  pub fnc on_message(int n): int {
    return even(n);
  }
}
pub fnc main(): int {
  const a: ActorRef<Worker> = spawn Worker();
  a.send(100000);
  stop a;
  return 43;
}
