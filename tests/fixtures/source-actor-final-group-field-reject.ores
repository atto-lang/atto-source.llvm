// Must reject without emitting native IR until typed actor-state ownership
// and ActorGroup suspension lowering can preserve the source contract.
define actor ConnectionActor as
  final rooms: Map<RoomId, ActorGroup>

  suspend method join_room(group: ActorGroup, permit: ActorGroupJoinCapability) {
    group.join(permit)
  }
  method leave_room(group: ActorGroup) {
    group.leave()
  }
end
