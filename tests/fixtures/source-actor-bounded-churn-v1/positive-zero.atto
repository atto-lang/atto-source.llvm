// Zero-trip loop must skip the actor construction completely.
define actor Worker as {
  const base: int = 40;
  pub fnc on_message(int n): int { return base + n; }
}
pub fnc main(): int {
  let iteration: int = 0;
  while iteration < 0 do
    const worker = spawn Worker();
    stop worker;
    iteration = iteration + 1;
  done
  return iteration;
}
