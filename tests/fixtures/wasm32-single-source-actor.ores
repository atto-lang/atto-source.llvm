// One private instance per Worker; state scopes cannot suspend.
define actor Counter as
  state { total: int = 0; }
  pub on_message(int increment): int with state.read, state.write {
    return using state.write(critical |s| -> {
      s.total = s.total + increment;
      return s.total;
    });
  }
end

pub fnc main(): int { return 42; }
