// Detached inverted struct value must outlive mutations of its source row.
// This must return 42 from real .atto -> verified MIR -> LLVM native AOT.
define inverted struct Position as
    let x: int;
    id: int;
end

fnc main(): int {
    let rows = InvertedArray<Position>.with_capacity(3);
    rows.push(42, 100);
    let saved = rows.snapshot(0);
    rows.push(9, 101);
    rows.set(0, x, 77);
    rows.erase_swap(0);
    return saved.x;
}
