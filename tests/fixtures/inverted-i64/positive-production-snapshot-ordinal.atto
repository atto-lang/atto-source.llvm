define inverted struct Position as
    let x: int;
    id: int;
end

fnc main(): int {
    let rows = InvertedArray<Position>.with_capacity(2);
    rows.push(7, 100);
    let earlier = rows.snapshot(0);
    rows.set(0, x, 42);
    let later = rows.snapshot(0);
    rows.set(0, x, 99);
    return later.x;
}
