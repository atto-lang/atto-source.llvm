define inverted struct Eight as
    a: int;
    b: int;
    c: int;
    d: int;
    e: int;
    f: int;
    g: int;
    h: int;
end

fnc main(): int {
    let rows = InvertedArray<Eight>.with_capacity(2);
    rows.push(1, 2, 3, 4, 5, 6, 7, 8);
    rows.push(11, 12, 13, 14, 15, 16, 42, 18);
    return rows.get(1, g);
}
