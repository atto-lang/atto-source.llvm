define actor Producer as {
  let count: int = 0;
  pub fnc on_message(int n): int { return n + count; }
}
define actor Consumer as {
  let count: int = 0;
  pub fnc on_message(int n): int { return n + count; }
}
pub fnc main(): int {
  const p = spawn Producer();
  const c = spawn Consumer();
  p.send(1);
  p pipe c;
  stop p;
  stop c;
  return 43;
}
