// Canonical .atto migration of tests/fixtures/source-actor-send-after-take-reject.ores; source behavior is unchanged.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  const count: int = 2;
  worker.send(rt take count);
  worker.send(count);
  stop worker;
  return 43;
}
