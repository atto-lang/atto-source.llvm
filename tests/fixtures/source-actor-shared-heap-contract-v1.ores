// Shared compiled-guest actor-private-heap acceptance fixture.
// Exit 43 is a sentinel, NOT evidence of isolation: the harness must observe
// generated on_message results, loan barriers and physical retirement.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    const previous: owned int = total + n;
    const doubled: owned int = previous + previous;
    total = doubled;
    return total;
  }
}
pub fnc main(): int {
  const a: ActorRef<Worker> = spawn Worker();
  const b: ActorRef<Worker> = spawn Worker();
  a.send(1);
  b.send(5);
  a.send(2);
  b.send(6);
  a.send(3);
  b.send(7);
  a.send(4);
  b.send(8);
  stop a;
  b.send(9);
  stop b;
  return 43;
}
