// Until the actor compiler emits a real continuation frame and schedules
// it on the same actor's TASK/WAKE lane, this must never fall back to the
// legacy foreign synthetic source Task pool.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int incoming): int {
    let Task<int> child = task { return 41; };
    return incoming;
  }
}
pub fnc main(): int {
  const worker = spawn Worker();
  worker.send(1);
  stop worker;
  return 43;
}
