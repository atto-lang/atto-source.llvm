// Legacy typed-ActorRef spelling: get_done requires an explicit stop first.
define actor Worker as {
  let total: int = 0;
  pub fnc on_message(int n): int {
    total = total + n;
    return total;
  }
}
pub fnc main(): int {
  const worker: ActorRef<Worker> = spawn Worker();
  await worker.get_done();
  return 43;
}
