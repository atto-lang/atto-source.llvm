// Opto Sync generation fence: stale and future claims cannot own current work.
pub fnc generation_ok(int observed, int current, int claim): int {
  if (current <= 0) { return 0; } fi
  if (observed < current) { return 0; } fi
  if (observed > current) { return 0; } fi
  if (claim < current) { return 0; } fi
  if (claim > current) { return 0; } fi
  return 1;
}
pub fnc main(): int {
  return 41 + generation_ok(7,7,7)
    + 10 * generation_ok(6,7,7) + 10 * generation_ok(8,7,7)
    + 10 * generation_ok(7,7,6) + 10 * generation_ok(7,7,8)
    + 10 * generation_ok(0,0,0);
}
