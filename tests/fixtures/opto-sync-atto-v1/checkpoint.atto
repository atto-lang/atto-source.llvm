// Opto Sync exact durable checkpoint admission. Pure AttoLang scalar guest.
pub fnc checkpoint_ok(int durable, int applied, int proposed): int {
  if (durable < 0) { return 0; } fi
  if (applied < durable) { return 0; } fi
  if (proposed < durable) { return 0; } fi
  if (proposed > applied) { return 0; } fi
  return 1;
}
pub fnc main(): int {
  return 40 + checkpoint_ok(2,5,5) + checkpoint_ok(2,5,2)
    + 10 * checkpoint_ok(2,5,1) + 10 * checkpoint_ok(2,5,6)
    + 10 * checkpoint_ok(-1,5,3) + 10 * checkpoint_ok(6,5,6);
}
