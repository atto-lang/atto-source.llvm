// Two distinct runtime assertions, both successful; guest owns all receipts.
// This is a fixed smoke guest, NOT std/testing TestSuite support.
pub routine main(): int {
  val int actual_a = 40 + 2;
  val int actual_b = 84 / 2;
  if actual_a != 42; then
    stdio.println("ORES_TEST|FAIL|llvm-native/multi-pass/a|expected=42");
    stdio.println("ORES_TEST|SUMMARY|total=1|passed=0|failed=1|skipped=0|filtered=0");
    return 1;
  fi
  stdio.println("ORES_TEST|PASS|llvm-native/multi-pass/a|");
  if actual_b != 42; then
    stdio.println("ORES_TEST|FAIL|llvm-native/multi-pass/b|expected=42");
    stdio.println("ORES_TEST|SUMMARY|total=2|passed=1|failed=1|skipped=0|filtered=0");
    return 1;
  fi
  stdio.println("ORES_TEST|PASS|llvm-native/multi-pass/b|");
  stdio.println("ORES_TEST|SUMMARY|total=2|passed=2|failed=0|skipped=0|filtered=0");
  return 0;
}
