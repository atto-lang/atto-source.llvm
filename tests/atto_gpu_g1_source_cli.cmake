if(NOT DEFINED COMPILER OR NOT DEFINED FIXTURE OR NOT DEFINED WORKDIR)
  message(FATAL_ERROR "COMPILER, FIXTURE and WORKDIR required")
endif()
file(MAKE_DIRECTORY "${WORKDIR}")
file(REMOVE "${WORKDIR}/generated.ll" "${WORKDIR}/invalid.atto")
execute_process(COMMAND "${COMPILER}" "${FIXTURE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE ir ERROR_VARIABLE err TIMEOUT 15)
if(NOT result STREQUAL "0" OR NOT err STREQUAL "")
  message(FATAL_ERROR "GPU-G1 canonical .atto source did not produce IR: ${err}")
endif()
foreach(fragment IN ITEMS "ptx_kernel void @saxpy" "nvptx64-nvidia-cuda"
       "icmp ult i64 %i, %n" "fmul float %scale" "store float %sum")
  string(FIND "${ir}" "${fragment}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "GPU-G1 missing IR fragment: ${fragment}")
  endif()
endforeach()
file(WRITE "${WORKDIR}/generated.ll" "${ir}")
file(READ "${FIXTURE}" source)
string(REPLACE "if i >= n { return; }" "" mutation "${source}")
if(mutation STREQUAL source)
  message(FATAL_ERROR "mutation did not change canonical G1 source")
endif()
file(WRITE "${WORKDIR}/invalid.atto" "${mutation}")
execute_process(COMMAND "${COMPILER}" "${WORKDIR}/invalid.atto"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE err TIMEOUT 15)
if(result STREQUAL "0" OR NOT output STREQUAL "" OR
   NOT err MATCHES "GPU-G1-001")
  message(FATAL_ERROR "missing bounded negative source-admission failure: ${err}")
endif()
file(GLOB generated RELATIVE "${WORKDIR}" "${WORKDIR}/*.ll")
if(NOT "${generated}" STREQUAL "generated.ll")
  message(FATAL_ERROR "failed GPU-G1 compile emitted unexpected LLVM artifact")
endif()
