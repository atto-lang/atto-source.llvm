// Actor-only method calls run on the owning actor stack, not on the sender.
// expect-exit: 0
// stdout-order: strict
// expect-stdout: 0
// expect-stdout: 1
// expect-stdout: 2
// expect-stdout: 3
define actor Worker as
    bump(int x): int { return x + 1; }
    receive(ActorMail<int> mail): void {
        stdio.println(mail.sequence);
        val doubled = self.bump(mail.value);
        return;
    }
end

pub fnc main(): int {
    val actor = spawn Worker();
    actor.send(1);
    actor.send(2);
    actor.send(3);
    actor.send(4);
    return 0;
}
