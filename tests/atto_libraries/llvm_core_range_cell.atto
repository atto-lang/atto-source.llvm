// expect-exit: 42
// LLVM-registered core/range and core/cell (atto-source.llvm#868).
import module range from "atto.core/range";
import module cell from "atto.core/cell";
pub fnc main(): int {
  val int r = (range.contains(0, 10, 5) ? 10 : 0) + (range.is_empty(3, 3) ? 10 : 0)
    + (range.overlaps(0, 5, 4, 9) ? 10 : 0) + (range.overlaps(0, 4, 4, 9) ? 100 : 0);
  val int c = (cell.may_borrow_exclusive(0) ? 5 : 0) + (cell.may_borrow_shared(0 - 1) ? 100 : 0)
    + (cell.is_valid_state(0 - 1) ? 5 : 0) + (cell.may_owner_write(2) ? 100 : 0);
  return r + c + 2;
}
