// expect-exit: 42
import module vec from "atto.alloc/vec";
import module num from "atto.core/num";
pub fnc main(): int {
  val int upper = num.max_value();
  val int lower = num.min_value();
  val int a = vec.sum_range(upper, 0);
  val int b = vec.sum_range(upper, 0 - 1);
  val int c = vec.sum_range(upper, 1) - upper;
  val int d = vec.sum_range(lower, 1) - lower;
  val int e = vec.sum_range(1, 100) - 36;
  val int f = vec.sum_range(2, 3) - 9;
  val int g = vec.sum_range(lower, 0);
  val int h = vec.sum_range(0 - 3, 4) + 6;
  val int failures =
    (a > 0 ? 1 : (a < 0 ? 1 : 0)) +
    (b > 0 ? 1 : (b < 0 ? 1 : 0)) +
    (c > 0 ? 1 : (c < 0 ? 1 : 0)) +
    (d > 0 ? 1 : (d < 0 ? 1 : 0)) +
    (e > 0 ? 1 : (e < 0 ? 1 : 0)) +
    (f > 0 ? 1 : (f < 0 ? 1 : 0)) +
    (g > 0 ? 1 : (g < 0 ? 1 : 0)) +
    (h > 0 ? 1 : (h < 0 ? 1 : 0));
  return failures > 0 ? 1 : 42;
}
