// expect-exit: 42
// LLVM-registered core/slice and core/iter plus the merged cmp helpers (atto-source.llvm#872).
import module slice from "atto.core/slice";
import module iter from "atto.core/iter";
import module cmp from "atto.core/cmp";
pub fnc main(): int {
  val int s = (slice.valid_range(1, 2, 3) ? 5 : 0) + (slice.valid_range(1, 3, 3) ? 100 : 0)
    + (slice.valid_index(2, 3) ? 5 : 0) + (slice.is_empty(0) ? 5 : 0) + (slice.can_split_at(3, 4) ? 100 : 0);
  val int i = (iter.valid_range(0, 3, 3) ? 5 : 0) + (iter.valid_range(2, 3, 3) ? 100 : 0);
  val int c = cmp.compare_int(1, 2) + cmp.compare_bool(true, false) + cmp.min_int(4, 9)
    + cmp.max_int(4, 9) + (cmp.valid_bounds(3, 2) ? 100 : 0);
  return s + i + c + 9;
}
