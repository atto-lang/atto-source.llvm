cmake_minimum_required(VERSION 3.20)
foreach(required IN ITEMS CORPUS COMPILER CLANG WORKDIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(SHA256 "${CORPUS}" digest)
if(NOT digest STREQUAL "e6e3394d5d62ec1f8171053b74a3b68389c41d5c797d81c14f561d1ca097a28b")
  message(FATAL_ERROR "Atto-XO shared corpus hash mismatch")
endif()
file(STRINGS "${CORPUS}" rows)
list(LENGTH rows count)
if(NOT count EQUAL 7)
  message(FATAL_ERROR "Expected seven shared guest sources")
endif()
file(MAKE_DIRECTORY "${WORKDIR}")
set(values 0)
set(faults 0)
set(ids "")
foreach(row IN LISTS rows)
  # Extract the source from the original row without CMake list conversion
  # (the guest contains semicolons).
  if(NOT row MATCHES "^([a-z-]+)[|](42|43|overflow)[|][0-9]+[|][0-9]+[|][0-9]+[|][-+*][|][0-9]+[|](.+)$")
    message(FATAL_ERROR "Malformed pinned row")
  endif()
  set(id "${CMAKE_MATCH_1}")
  set(expected "${CMAKE_MATCH_2}")
  set(source "${CMAKE_MATCH_3}")
  if(id IN_LIST ids)
    message(FATAL_ERROR "Duplicate guest ${id}")
  endif()
  list(APPEND ids "${id}")
  set(base "${WORKDIR}/${id}")
  file(WRITE "${base}.atto" "${source}")
  file(REMOVE "${base}.ll")
  execute_process(COMMAND "${COMPILER}" "${base}.atto"
    RESULT_VARIABLE compiled OUTPUT_FILE "${base}.ll"
    ERROR_VARIABLE compiler_error TIMEOUT 15)
  if(NOT "${compiled}" STREQUAL "0" OR NOT EXISTS "${base}.ll")
    message(FATAL_ERROR "Guest compilation failed ${id}: ${compiled}: ${compiler_error}")
  endif()
  file(SIZE "${base}.ll" size)
  if(size LESS 16 OR size GREATER 131072)
    message(FATAL_ERROR "Invalid LLVM IR size ${id}")
  endif()
  if(expected STREQUAL "overflow")
    file(READ "${base}.ll" ir LIMIT 131072)
    if(NOT ir MATCHES "llvm[.]trap" OR NOT ir MATCHES "with[.]overflow")
      message(FATAL_ERROR "Missing checked overflow lowering: ${id}")
    endif()
    math(EXPR faults "${faults}+1")
  else()
    math(EXPR values "${values}+1")
  endif()
  foreach(opt IN ITEMS O0 O2)
    set(binary "${base}.${opt}.native")
    file(REMOVE "${binary}")
    execute_process(COMMAND "${CLANG}" "-${opt}" -Wno-override-module -x ir "${base}.ll" -o "${binary}"
      RESULT_VARIABLE linked OUTPUT_VARIABLE link_output ERROR_VARIABLE link_error TIMEOUT 20)
    if(NOT "${linked}" STREQUAL "0" OR NOT EXISTS "${binary}")
      message(FATAL_ERROR "Native link failed ${id} ${opt}: ${linked}: ${link_error}")
    endif()
    execute_process(COMMAND "${binary}" RESULT_VARIABLE observed
      OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
    if(NOT "${out}" STREQUAL "" OR NOT "${err}" STREQUAL "")
      message(FATAL_ERROR "Unexpected guest output ${id} ${opt}")
    endif()
    if(expected STREQUAL "overflow")
      if(NOT "${observed}" MATCHES "^(Illegal instruction|Trace/breakpoint trap|Abort trap)$")
        message(FATAL_ERROR "Expected native overflow trap ${id} ${opt}: ${observed}")
      endif()
    elseif(NOT "${observed}" STREQUAL "${expected}")
      message(FATAL_ERROR "Unexpected value ${id} ${opt}: ${observed} vs ${expected}")
    endif()
    message(STATUS "Atto-XO ${id} ${opt}: ${observed}")
  endforeach()
endforeach()
if(NOT values EQUAL 3 OR NOT faults EQUAL 4)
  message(FATAL_ERROR "Incorrect value/fault census")
endif()
message(STATUS "14 actual native guest processes: 6 value results, 8 checked traps")
