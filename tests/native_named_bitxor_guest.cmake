cmake_minimum_required(VERSION 3.20)
# Executable source -> production oreslang-llvmc -> LLVM IR -> Clang -> OS
# exit-code conformance. Not a host-only arithmetic oracle.
foreach(required IN ITEMS LLVM_COMPILER NATIVE_CLANG WORK_DIR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing native guest test argument: ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK_DIR}")
set(positive "${WORK_DIR}/named-bitxor-positive.ores")
file(WRITE "${positive}" "fnc xor_two(int a, int b):int { return Integer.bitXor(a,b); }\nfnc main():int { return xor_two(5,3); }\n")
execute_process(
    COMMAND "${LLVM_COMPILER}" "${positive}"
    RESULT_VARIABLE status OUTPUT_VARIABLE ir ERROR_VARIABLE diagnostic TIMEOUT 30
)
if(NOT "${status}" STREQUAL "0")
    message(FATAL_ERROR "Native compiler rejected typed guest Integer.bitXor: ${status} ${diagnostic}")
endif()
string(FIND "${ir}" "xor i64" xor_index)
if(xor_index LESS 0)
    message(FATAL_ERROR "Native guest program emitted no XOR i64 instruction")
endif()
set(ir_file "${WORK_DIR}/named-bitxor.ll")
set(executable "${WORK_DIR}/named-bitxor")
file(WRITE "${ir_file}" "${ir}")
execute_process(COMMAND "${NATIVE_CLANG}" "-x" "ir" "${ir_file}" "-o" "${executable}"
    RESULT_VARIABLE clang_status OUTPUT_VARIABLE clang_out ERROR_VARIABLE clang_err TIMEOUT 60)
if(NOT "${clang_status}" STREQUAL "0")
    message(FATAL_ERROR "Clang failed native guest link: ${clang_status} ${clang_err}")
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE guest_status
    OUTPUT_VARIABLE guest_stdout ERROR_VARIABLE guest_stderr TIMEOUT 15)
if(NOT "${guest_status}" STREQUAL "6")
    message(FATAL_ERROR "Native guest Integer.bitXor expected OS exit 6, got ${guest_status}: ${guest_stderr} ${guest_stdout}")
endif()
# Additional exact Java strict signed64 XOR result vectors. Compare the
# full 64-bit result *inside* the guest and return status 0 for equality.
# OS exit status alone truncates on POSIX and cannot prove 64-bit equality.
foreach(case_name IN ITEMS zero negative min_max)
    if(case_name STREQUAL "zero")
        set(left "0")
        set(right "0")
        set(expected "0")
    elseif(case_name STREQUAL "negative")
        set(left "-1")
        set(right "0")
        set(expected "-1")
    else()
        set(left "-9223372036854775808")
        set(right "9223372036854775807")
        set(expected "-1")
    endif()
    set(source "${WORK_DIR}/xor-${case_name}.ores")
    set(llvm_ir "${WORK_DIR}/xor-${case_name}.ll")
    set(binary "${WORK_DIR}/xor-${case_name}")
    file(WRITE "${source}" "fnc main():int { return (Integer.bitXor(${left},${right}) == ${expected}) ? 0 : 1; }\n")
    execute_process(COMMAND "${LLVM_COMPILER}" "${source}"
        RESULT_VARIABLE result OUTPUT_VARIABLE result_ir ERROR_VARIABLE result_err TIMEOUT 30)
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "LLVM compiler rejected Java XOR ${case_name} vector: ${result_err}")
    endif()
    file(WRITE "${llvm_ir}" "${result_ir}")
    execute_process(COMMAND "${NATIVE_CLANG}" "-x" "ir" "${llvm_ir}" "-o" "${binary}"
        RESULT_VARIABLE cc_status OUTPUT_VARIABLE cc_out ERROR_VARIABLE cc_err TIMEOUT 60)
    if(NOT "${cc_status}" STREQUAL "0")
        message(FATAL_ERROR "Clang failed ${case_name}: ${cc_err}")
    endif()
    execute_process(COMMAND "${binary}" RESULT_VARIABLE exit_status
        OUTPUT_VARIABLE program_out ERROR_VARIABLE program_err TIMEOUT 15)
    if(NOT "${exit_status}" STREQUAL "0")
        message(FATAL_ERROR "Native Java XOR ${case_name}: expected exact 64-bit equality, got OS exit ${exit_status}; ${program_err}")
    endif()
endforeach()
# Both operands are eager: a checked overflow must trap instead of
# producing a seemingly valid XOR result. LLVM's current signed64 error ABI
# is a native trap, not a typed Result/Option.
foreach(side IN ITEMS left right)
    if(side STREQUAL "left")
        set(expression "Integer.bitXor(9223372036854775807+1,0)")
    else()
        set(expression "Integer.bitXor(0,9223372036854775807+1)")
    endif()
    set(source "${WORK_DIR}/xor-overflow-${side}.ores")
    set(ir_file "${WORK_DIR}/xor-overflow-${side}.ll")
    set(binary "${WORK_DIR}/xor-overflow-${side}")
    file(WRITE "${source}" "fnc main():int { return ${expression}; }\n")
    execute_process(COMMAND "${LLVM_COMPILER}" "${source}"
        RESULT_VARIABLE emit_status OUTPUT_VARIABLE emitted_ir ERROR_VARIABLE emit_err TIMEOUT 30)
    if(NOT "${emit_status}" STREQUAL "0")
        message(FATAL_ERROR "Native compiler did not admit checked XOR operand test: ${emit_err}")
    endif()
    file(WRITE "${ir_file}" "${emitted_ir}")
    execute_process(COMMAND "${NATIVE_CLANG}" "-x" "ir" "${ir_file}" "-o" "${binary}"
        RESULT_VARIABLE clang_status OUTPUT_VARIABLE clang_stdout ERROR_VARIABLE clang_stderr TIMEOUT 60)
    if(NOT "${clang_status}" STREQUAL "0")
        message(FATAL_ERROR "Native checked XOR guest failed Clang: ${clang_stderr}")
    endif()
    execute_process(COMMAND "${binary}" RESULT_VARIABLE guest_status
        OUTPUT_VARIABLE guest_stdout ERROR_VARIABLE guest_stderr TIMEOUT 15)
    if("${guest_status}" STREQUAL "0" OR NOT "${guest_stdout}" STREQUAL "")
        message(FATAL_ERROR "Checked ${side} operand overflow silently completed: status=${guest_status}, stdout=${guest_stdout}")
    endif()
endforeach()
# All four negative cases must fail in compiler/typecheck before LLVM IR.
foreach(case_name IN ITEMS wrong_arity too_many boolean_operand unknown_method)
    if(case_name STREQUAL "wrong_arity")
        set(expression "Integer.bitXor(5)")
    elseif(case_name STREQUAL "too_many")
        set(expression "Integer.bitXor(5,3,1)")
    elseif(case_name STREQUAL "boolean_operand")
        set(expression "Integer.bitXor(true,3)")
    else()
        set(expression "Integer.unknownStrictMethod(5,3)")
    endif()
    set(input "${WORK_DIR}/${case_name}.ores")
    file(WRITE "${input}" "fnc main():int { return ${expression}; }\n")
    execute_process(COMMAND "${LLVM_COMPILER}" "${input}"
        RESULT_VARIABLE result OUTPUT_VARIABLE rejected_ir ERROR_VARIABLE rejected_err TIMEOUT 15)
    if("${result}" STREQUAL "0" OR NOT "${rejected_ir}" STREQUAL "" OR "${rejected_err}" STREQUAL "")
        message(FATAL_ERROR "Compiler failed to reject ${case_name} before IR: exit=${result}, stdout=${rejected_ir}, stderr=${rejected_err}")
    endif()
endforeach()
message(STATUS "Native guest Integer.bitXor: real LLVM IR and OS exit 6, four frontend denials verified")
