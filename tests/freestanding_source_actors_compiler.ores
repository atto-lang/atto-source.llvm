define actor Source as {
    const base: int = 40;
    let total: int = 0;
    pub fnc on_message(int n): int {
        total = total + base + n;
        return total;
    }
}

define actor Sink as {
    let total: int = 5;
    pub fnc on_message(int n): int {
        total = total + n;
        return total;
    }
}

pub fnc main(): int {
    const a = spawn Source();
    const b = spawn Sink();
    a.send(1);
    b.send(11);
    a.send(2);
    b.send(3);
    stop a;
    stop b;
    return 43;
}
