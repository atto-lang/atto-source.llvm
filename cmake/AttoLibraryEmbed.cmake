# Generates GeneratedAttoLibraryTable.inc from stdlib/LIBRARIES.txt.
# Each unit's bytes become a C++ raw string literal; editing any listed
# source or the manifest re-runs configuration.
function(atto_generate_library_table out_dir)
  set(manifest "${CMAKE_CURRENT_SOURCE_DIR}/stdlib/LIBRARIES.txt")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
  file(STRINGS "${manifest}" lines)
  set(body "// Generated from stdlib/LIBRARIES.txt by cmake/AttoLibraryEmbed.cmake; do not edit.\n")
  foreach(line IN LISTS lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "[ \t]+" ";" cols "${line}")
    list(LENGTH cols ncols)
    if(NOT (ncols EQUAL 4 OR ncols EQUAL 5))
      message(FATAL_ERROR "stdlib/LIBRARIES.txt: expected 4 or 5 columns: ${line}")
    endif()
    set(providers "default")
    if(ncols EQUAL 5)
      list(GET cols 4 providers)
    endif()
    list(GET cols 0 layer)
    list(GET cols 1 unit)
    list(GET cols 2 file)
    list(GET cols 3 os)
    if(NOT layer MATCHES "^(core|alloc|std)$")
      message(FATAL_ERROR "stdlib/LIBRARIES.txt: bad layer ${layer}")
    endif()
    if(NOT unit MATCHES "^[a-z][a-z0-9_]*$")
      message(FATAL_ERROR "stdlib/LIBRARIES.txt: bad unit ${unit}")
    endif()
    set(src "${CMAKE_CURRENT_SOURCE_DIR}/${file}")
    if(NOT EXISTS "${src}")
      message(FATAL_ERROR "stdlib/LIBRARIES.txt: missing ${file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${src}")
    file(READ "${src}" text)
    if(text MATCHES "\\)ATTO_LIB\"")
      message(FATAL_ERROR "${file}: raw literal delimiter collision")
    endif()
    get_filename_component(stem "${file}" NAME_WE)
    if(layer STREQUAL "core")
      set(tier "CompilerLibraryTier::Core")
      set(bits "0u")
    elseif(layer STREQUAL "alloc")
      set(tier "CompilerLibraryTier::Alloc")
      set(bits "core_provider_bit(CoreProviderRequirement::Allocator)")
    else()
      set(tier "CompilerLibraryTier::Std")
      set(bits "0u")
    endif()
    if(providers STREQUAL "none")
      set(bits "0u")
    elseif(providers STREQUAL "allocator")
      set(bits "core_provider_bit(CoreProviderRequirement::Allocator)")
    elseif(NOT providers STREQUAL "default")
      message(FATAL_ERROR "stdlib/LIBRARIES.txt: bad providers ${providers}")
    endif()
    if(os STREQUAL "posix")
      set(osf "LibraryOsFilter::Posix")
    elseif(os STREQUAL "windows")
      set(osf "LibraryOsFilter::Windows")
    else()
      set(osf "LibraryOsFilter::Any")
    endif()
    string(APPEND body "CoreLibrarySource{${tier}, \"atto.${layer}/${unit}\", \"${unit}\", \"@atto.${layer}/${stem}.atto\",\nR\"ATTO_LIB(${text})ATTO_LIB\",\n${bits}, ${osf}},\n")
  endforeach()
  file(MAKE_DIRECTORY "${out_dir}/oreslang/frontend")
  file(WRITE "${out_dir}/GeneratedAttoLibraryTable.inc.tmp" "${body}")
  configure_file("${out_dir}/GeneratedAttoLibraryTable.inc.tmp"
    "${out_dir}/oreslang/frontend/GeneratedAttoLibraryTable.inc" COPYONLY)
endfunction()
