// std/metrics -- bounded, actor-owned in-memory metric aggregation.
// Source-only policy; no host telemetry API, time, I/O or background tasks.
// Mutation requires one owner (e.g. a collector actor). No shared-state claim.
define module metrics as
  pub fnc valid_name(String name): bool {
    let points = name.codepoints();
    if points.size < 1 || points.size > 128; do return false; fi
    for (let int i = 0; i < points.size; i = i + 1) {
      let int ch = points.get(i);
      let bool letter = (ch >= 65 && ch <= 90) ||
                        (ch >= 97 && ch <= 122);
      let bool symbol = ch == 95 || ch == 58;
      let bool digit = ch >= 48 && ch <= 57;
      if !(letter || symbol || (i > 0 && digit)); do
        return false;
      fi
    }
    return true;
  }

  pub define class Counter as
    let mut int current = 0;
    let int ceiling;

    pub constructor(int ceiling) {
      if ceiling < 0 || ceiling > 2147483647; do
        rt fail("metrics: invalid counter ceiling");
      fi
      self.ceiling = ceiling;
    }

    // False means rejected without mutation (negative or overflow).
    pub add(mut self)(int amount): bool {
      if amount < 0 || amount > self.ceiling - self.current; do
        return false;
      fi
      self.current = self.current + amount;
      return true;
    }
    pub increment(mut self)(): bool { return self.add(1); }
    pub value(): int { return self.current; }
    pub limit(): int { return self.ceiling; }
    pub reset(mut self)(): int {
      let int previous = self.current;
      self.current = 0;
      return previous;
    }
  end

  pub define class Gauge as
    let int lower;
    let int upper;
    let mut int current;

    pub constructor(int lower, int upper, int initial) {
      if lower > upper || initial < lower || initial > upper; do
        rt fail("metrics: invalid gauge bounds");
      fi
      self.lower = lower;
      self.upper = upper;
      self.current = initial;
    }

    // An explicit set avoids overflowing delta arithmetic.
    pub set(mut self)(int value): bool {
      if value < self.lower || value > self.upper; do return false; fi
      self.current = value;
      return true;
    }
    pub value(): int { return self.current; }
    pub minimum(): int { return self.lower; }
    pub maximum(): int { return self.upper; }
  end

  pub define class Histogram as
    let mut Array<int> thresholds = new Array<int>();
    let mut Array<int> counts = new Array<int>();
    let mut int samples = 0;
    let mut int total = 0;
    let mut int rejected = 0;

    // Sorted, strictly increasing nonnegative *inclusive* upper bounds.
    // Last bucket is +Inf; count and sum are bounded signed integers.
    pub constructor(Array<int> bounds) {
      if bounds.size > 64; do rt fail("metrics: too many buckets"); fi
      for (let int i = 0; i < bounds.size; i = i + 1) {
        let int value = bounds.get(i);
        if value < 0 || (i > 0 && value <= bounds.get(i - 1)); do
          rt fail("metrics: unsorted histogram bounds");
        fi
        self.thresholds.add(value);
        self.counts.add(0);
      }
      self.counts.add(0);
    }

    // Fully preflighted before any histogram state changes.
    pub observe(mut self)(int value): bool {
      if value < 0 || self.samples == 2147483647 ||
         value > 2147483647 - self.total; do
        if self.rejected < 2147483647; do
          self.rejected = self.rejected + 1;
        fi
        return false;
      fi
      let int bucket = self.thresholds.size;
      for (let int i = 0; i < self.thresholds.size; i = i + 1) {
        if value <= self.thresholds.get(i); do
          bucket = i;
          break;
        fi
      }
      // All bucket counters <= samples, so no bucket can overflow first.
      self.counts.set(bucket, self.counts.get(bucket) + 1);
      self.samples = self.samples + 1;
      self.total = self.total + value;
      return true;
    }

    pub count(): int { return self.samples; }
    pub sum(): int { return self.total; }
    pub rejected_count(): int { return self.rejected; }
    pub bucket_count(int index): Result<int, String> {
      if index < 0 || index >= self.counts.size; do
        return Err("BucketOutOfRange");
      fi
      return Ok(self.counts.get(index));
    }
    pub bucket_upper(int index): Result<int, String> {
      if index < 0 || index >= self.thresholds.size; do
        return Err("NoFiniteUpperBound");
      fi
      return Ok(self.thresholds.get(index));
    }
    pub bucket_total(): int { return self.counts.size; }
  end

  pub fnc counter(int maximum): Counter {
    return new Counter(maximum);
  }
  pub fnc gauge(int minimum, int maximum, int initial): Gauge {
    return new Gauge(minimum, maximum, initial);
  }
  pub fnc histogram(Array<int> upper_bounds): Histogram {
    return new Histogram(upper_bounds);
  }
end
