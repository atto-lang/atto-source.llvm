// AttoLang alloc/pool: bounded, single-owner slot-reuse policy.
// SOURCE-LEVEL SLOT METADATA ONLY. The allocator owns the actual T payload,
// proves that all borrows ended, destroys T, and scrubs storage before release.
// Lease numbers are NOT authentication capabilities or cross-actor handles.
define module pool as

  pub define class PoolLease as
    pub val int slot;
    pub val int generation;

    pub constructor(int slot, int generation) {
      self.slot = slot;
      self.generation = generation;
    }

    pub valid(): bool {
      return self.slot >= 0 && self.generation >= 1;
    }
  end

  // state: 0=free, 1=leased, 2=permanently retired.
  // A retired generation is never reused. O(capacity) bounded first-fit scan.
  pub define class SlotPool as
    let int limit;
    let mut Array<int> states = new Array<int>();
    let mut Array<int> generations = new Array<int>();
    let mut int next_slot = 0;
    let mut int in_use = 0;
    let mut int exhausted = 0;
    let mut bool closed = false;

    pub constructor(int capacity) {
      if capacity < 1 || capacity > 65536; do
        rt fail("alloc/pool: capacity must be 1..65536");
      fi
      self.limit = capacity;
      for (let i = 0; i < capacity; i++) do
        self.states.add(0);
        self.generations.add(1);
      done
    }

    // Invalid lease (-1, 0) means full, retired or closed.
    pub acquire(mut self)(): PoolLease {
      if self.closed || self.in_use >= self.limit - self.exhausted; do
        return new PoolLease(-1, 0);
      fi
      for (let step = 0; step < self.limit; step++) do
        let int index = self.next_slot + step;
        if index >= self.limit; do
          index = index - self.limit;
        fi
        if self.states.get(index) == 0; do
          self.states.set(index, 1);
          self.in_use = self.in_use + 1;
          self.next_slot = index + 1;
          if self.next_slot == self.limit; do
            self.next_slot = 0;
          fi
          return new PoolLease(index, self.generations.get(index));
        fi
      done
      return new PoolLease(-1, 0);
    }

    // Caller MUST finish T's destructor/zeroization and prove no live loans
    // before calling release. This only retires metadata.
    pub release(mut self)(PoolLease lease): bool {
      if self.closed || !lease.valid() ||
         lease.slot >= self.limit ||
         self.states.get(lease.slot) != 1 ||
         self.generations.get(lease.slot) != lease.generation; do
        return false;
      fi
      self.in_use = self.in_use - 1;
      if lease.generation >= 2147483647; do
        self.states.set(lease.slot, 2);
        self.exhausted = self.exhausted + 1;
      else
        self.generations.set(lease.slot, lease.generation + 1);
        self.states.set(lease.slot, 0);
      fi
      return true;
    }

    pub close(mut self)(): bool {
      if self.in_use != 0; do
        return false;
      fi
      self.closed = true;
      return true;
    }

    pub capacity(): int { return self.limit; }
    pub active(): int { return self.in_use; }
    pub retired(): int { return self.exhausted; }
    pub available(): int { return self.limit - self.exhausted - self.in_use; }
    pub is_closed(): bool { return self.closed; }
  end

  pub fnc slot_pool(int capacity): SlotPool {
    return new SlotPool(capacity);
  }

end
