// AttoLang LLVM M1 bounded hosted scalar ledger; no closures or host test bodies.
// Canonical compiler-owned source identity: ores.std/testing/m1.atto.
// A TestCase is a VALUE DESCRIPTION: the caller must evaluate its body only if
// should_run() returns true, then set outcome 0=PASS or 1=FAIL.
// This is NOT the full ore.std/testing TestBody or nested TestSuite API.
define module testing_m1 as
  pub define class TestCase as
    pub let int id = 0;
    pub let int outcome = 0;
    pub let bool selected = true;
    pub let bool skipped = false;
  end

  pub define class TestSuite as
    pub let int total = 0;
    pub let int passed = 0;
    pub let int failed = 0;
    pub let int skipped = 0;
    pub let int filtered = 0;
    pub let int halted = 0;
    // Highest admitted case ID, including skipped or filtered descriptors.
    // Strictly ascending IDs prohibit replay across distinct TestCase objects.
    pub let int last_id = 0;
    pub let bool fail_fast = false;
  end

  pub define class RunSummary as
    pub let int total = 0;
    pub let int passed = 0;
    pub let int failed = 0;
    pub let int skipped = 0;
    pub let int filtered = 0;
  end

  pub fnc should_run(borrow TestSuite suite, borrow TestCase candidate): bool {
    return suite.halted == 0 && candidate.selected && !candidate.skipped &&
      candidate.id > 0 && candidate.id > suite.last_id &&
      suite.total >= 0 && suite.total < 1024;
  }

  // 0 PASS, 1 FAIL, 2 SKIP, 3 FILTER, 4 NOT_RUN after fail-fast;
  // -1 invalid descriptor, -2 quota exceeded, -4 replayed/out-of-order ID.
  // Rejections are atomic, including the last admitted identity.
  pub fnc record(borrow mut TestSuite suite, borrow TestCase candidate): int {
    if suite.halted != 0; then
      return 4;
    fi
    if candidate.id <= 0 || candidate.outcome < 0 || candidate.outcome > 1; then
      return -1;
    fi
    if candidate.id <= suite.last_id; then
      return -4;
    fi
    if !candidate.selected; then
      if suite.filtered >= 1024; then
        return -2;
      fi
      suite.filtered = suite.filtered + 1;
      suite.last_id = candidate.id;
      return 3;
    fi
    if suite.total >= 1024; then
      return -2;
    fi
    suite.total = suite.total + 1;
    suite.last_id = candidate.id;
    if candidate.skipped; then
      suite.skipped = suite.skipped + 1;
      return 2;
    fi
    if candidate.outcome == 0; then
      suite.passed = suite.passed + 1;
      return 0;
    fi
    suite.failed = suite.failed + 1;
    if suite.fail_fast; then
      suite.halted = 1;
    fi
    return 1;
  }

  // Returns 2 on structurally corrupt ledgers, without touching result.
  // Returns 1 on empty/skipped/filtered-only suites or any failure.
  // A positive suite result is NOT a cryptographic or untrusted-run receipt:
  // guests currently own these public counters.
  pub fnc finish(borrow TestSuite suite, borrow mut RunSummary result): int {
    // Validate before addition and before publishing ANY summary fields.
    if suite.total < 0 || suite.total > 1024 ||
      suite.filtered < 0 || suite.filtered > 1024 ||
      suite.passed < 0 || suite.failed < 0 || suite.skipped < 0 ||
      suite.last_id < 0 || suite.halted < 0 || suite.halted > 1; then
      return 2;
    fi
    if suite.total != suite.passed + suite.failed + suite.skipped; then
      return 2;
    fi
    if suite.total + suite.filtered == 0 && suite.last_id != 0; then
      return 2;
    fi
    if suite.total + suite.filtered > 0 && suite.last_id <= 0; then
      return 2;
    fi
    if suite.halted != 0 && (!suite.fail_fast || suite.failed != 1); then
      return 2;
    fi
    if suite.fail_fast && suite.failed > 0 && suite.halted == 0; then
      return 2;
    fi
    result.total = suite.total;
    result.passed = suite.passed;
    result.failed = suite.failed;
    result.skipped = suite.skipped;
    result.filtered = suite.filtered;
    if result.passed + result.failed == 0; then
      return 1;
    fi
    if result.failed > 0; then
      return 1;
    fi
    return 0;
  }
end
