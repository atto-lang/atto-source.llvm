    "generation": "monotone checked, never wrap/reuse stale identity",
    "quotas": "preflight overflow, alignment, physical reserved bytes plus metadata and tenant/actor caps before publication",
    "slice": "region-bound non-owning capability, compile reject escape/transfer/unpinned suspension",
    "zeroing": "zero before exposure and before cross-tenant reuse; confidentiality hooks are explicit",
    "failed_reservation": "fail atomic; no leaked quota or partially published handle",
    "ffi": "no forged host pointer, raw offset, or untracked external callback"
  },
