// Executed guest scalar ABI checkpoint, NOT a slab allocation or I/O API.
// Request ticket: incarnation * 2^32 + row (row <= 65535).
// Receipt claim: serial * 2^32 + (row * 8 + lane + 1).
// LLVM rejects int division and remainder today, so this checks packing
// using only signed-i64 addition, multiplication, and subtraction.
fnc packed_ticket(): int {
  return 17 * 4294967296 + 65535;
}
fnc packed_receipt(): int {
  return 23 * 4294967296 + (7 * 8 + 3);
}
pub fnc main(): int {
  return 42 + (packed_ticket() - 73014509567)
       + (packed_receipt() - 98784247867);
}
