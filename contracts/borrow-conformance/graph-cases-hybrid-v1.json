{
  "schema": "atto-borrow-graph-cases-v1",
  "version": 1,
  "engine": "hybrid",
  "rustCanonical": "atto-borrow-mir-v1",
  "scope": "branches and loops past the V0 model limits: V0 first, then cyclic_v1 (src/hybrid_v1.rs)",
  "note": "Every case is one V0 cannot decide (E_CFG_JOIN_UNPROVEN or E_CFG_CYCLE_UNPROVEN), except where V0 already rejects at an op before reaching the join (H07, H08), with the same code; tests/hybrid_v1.rs asserts exactly that. Expectations are the hybrid canonical verdict used by cross-check; they are authored from the ownership semantics, not generated.",
  "cases": [
    {"id": "H01", "category": "joins", "expected": "accept", "diagnostic": null,
     "note": "move on one arm, read on the other, nothing after the join",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Move", "from": 1, "into": 2}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H02", "category": "joins", "expected": "reject", "diagnostic": "E_USE_AFTER_MOVE_OR_DROP",
     "note": "MAY-moved owner read after the join",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Move", "from": 1, "into": 2}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Read", "owner": 1}, {"op": "Return"}], "successors": []}]}},
    {"id": "H03", "category": "joins", "expected": "accept", "diagnostic": null,
     "note": "moved on both arms into distinct owners; neither used after",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Move", "from": 1, "into": 2}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Move", "from": 1, "into": 3}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H04", "category": "joins", "expected": "reject", "diagnostic": "E_LOAN_ESCAPE",
     "note": "loan taken on one arm reaches the exit",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Shared"}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H05", "category": "joins", "expected": "reject", "diagnostic": "E_UNKNOWN_LOAN",
     "note": "loan ended after a join where only one arm borrowed: adapter defect",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Shared"}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "EndBorrow", "loan": 10}, {"op": "Return"}], "successors": []}]}},
    {"id": "H06", "category": "joins", "expected": "reject", "diagnostic": "E_SUSPEND_WITH_LIVE_LOAN",
     "note": "MAY-live loan crosses a suspension after the join",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Shared"}, {"op": "EndBorrow", "loan": 10},
                         {"op": "Borrow", "owner": 1, "loan": 11, "kind": "Shared"}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Suspend"}, {"op": "Return"}], "successors": []}]}},
    {"id": "H07", "category": "joins", "expected": "reject", "diagnostic": "E_TASK_CAPTURE_PROOF",
     "note": "non-Send task capture on one arm",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "TaskCaptureMove", "owner": 1}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H08", "category": "joins", "expected": "reject", "diagnostic": "E_ACTOR_SEND_PROOF_REQUIRED",
