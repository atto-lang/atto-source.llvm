     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "ActorSendMove", "owner": 1}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H09", "category": "joins", "expected": "accept", "diagnostic": null,
     "note": "Send owner sent on one arm, unused after the join",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": true}], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "ActorSendMove", "owner": 1}], "successors": [3]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}], "successors": [3]},
       {"id": 3, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H10", "category": "loops", "expected": "accept", "diagnostic": null,
     "note": "loop reads a live owner; exit after the loop",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Read", "owner": 1}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H11", "category": "loops", "expected": "reject", "diagnostic": "E_USE_AFTER_MOVE_OR_DROP",
     "note": "move inside a loop body: use after move on the second iteration",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Move", "from": 1, "into": 2}, {"op": "Drop", "owner": 2}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H12", "category": "loops", "expected": "accept", "diagnostic": null,
     "note": "exclusive loan taken, written through and ended within each iteration",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Mutable"},
                         {"op": "WriteThrough", "owner": 1, "loan": 10}, {"op": "EndBorrow", "loan": 10}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H13", "category": "loops", "expected": "reject", "diagnostic": "E_BORROW_CONFLICT",
     "note": "loan still live at the back-edge is re-borrowed by the next iteration",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Shared"}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "EndBorrow", "loan": 10}, {"op": "Return"}], "successors": []}]}},
    {"id": "H14", "category": "loops", "expected": "reject", "diagnostic": "E_OWNER_DEF_REUSED",
     "note": "loop-local owner re-initialized each iteration without a release: the adapter must Drop or Move it before the back-edge",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Init", "owner": 2, "copy": false, "send": false}, {"op": "Read", "owner": 2}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H15", "category": "loops", "expected": "accept", "diagnostic": null,
     "note": "loop-local owner initialized and dropped each iteration",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Init", "owner": 2, "copy": false, "send": false}, {"op": "Read", "owner": 2},
                         {"op": "Drop", "owner": 2}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Read", "owner": 1}, {"op": "Return"}], "successors": []}]}},
    {"id": "H16", "category": "loops", "expected": "reject", "diagnostic": "E_MUT_LOAN_REQUIRED",
     "note": "write through a shared loan inside a loop",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "Borrow", "owner": 1, "loan": 10, "kind": "Shared"},
                         {"op": "WriteThrough", "owner": 1, "loan": 10}, {"op": "EndBorrow", "loan": 10}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H17", "category": "loops", "expected": "reject", "diagnostic": "E_CFG_CYCLE_UNPROVEN",
     "note": "an op outside the lowered subset (DeepCopy) keeps the V0 model limit: OUT_OF_SCOPE, not a guess",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [1]},
       {"id": 1, "ops": [{"op": "DeepCopy", "from": 1, "into": 2, "graphProven": true}, {"op": "Drop", "owner": 2}], "successors": [1, 2]},
       {"id": 2, "ops": [{"op": "Return"}], "successors": []}]}},
    {"id": "H18", "category": "joins", "expected": "reject", "diagnostic": "E_USE_AFTER_MOVE_OR_DROP",
     "note": "owner read after a join where only one arm initialized it (never-owned on the other path)",
     "graph": {"entry": 0, "blocks": [
       {"id": 0, "ops": [], "successors": [1, 2]},
       {"id": 1, "ops": [{"op": "Init", "owner": 1, "copy": false, "send": false}], "successors": [3]},
       {"id": 2, "ops": [], "successors": [3]},
       {"id": 3, "ops": [{"op": "Read", "owner": 1}, {"op": "Return"}], "successors": []}]}}
  ]
