// Canonical DOP v1 negative: an immutable column cannot be written.
// Both LLVM and Java's opt-in compiler must reject before execution.
define inverted struct Row as
    let value: int;
    token: int;
end

fnc main(): int {
    let rows = InvertedArray<Row>.with_capacity(2);
    rows.push(11, 100);
    rows.set(0, token, 42);
    return rows.get(0, value);
}
