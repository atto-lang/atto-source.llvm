cmake_minimum_required(VERSION 3.20)
set(fixture_dir "${CMAKE_CURRENT_LIST_DIR}")
set(manifest "${fixture_dir}/manifest-v1.json")
file(READ "${manifest}" bytes)
file(SIZE "${manifest}" nbytes)
file(SHA256 "${manifest}" digest)
file(READ "${fixture_dir}/manifest-v1.sha256" recorded)
string(STRIP "${recorded}" recorded)
set(expected "aa1eed7637b99d8c270c3cd7a3f15ab83acf0463b00ebaa58f0f52c8dd525784")
if(NOT digest STREQUAL expected OR NOT recorded STREQUAL expected OR NOT nbytes EQUAL 1671)
  message(FATAL_ERROR "DURABLE_M0_MANIFEST_DRIFT: wrong exact candidate canonical bytes or digest")
endif()
string(JSON format ERROR_VARIABLE err GET "${bytes}" format)
if(err OR NOT format STREQUAL "atto.durable.manifest.v1")
  message(FATAL_ERROR "DURABLE_M0_MANIFEST_FORMAT_MISMATCH")
endif()
string(JSON activity ERROR_VARIABLE err GET "${bytes}" activities 0 id)
if(err OR NOT activity STREQUAL "Billing.PaymentProvider")
  message(FATAL_ERROR "DURABLE_M0_ACTIVITY_TARGET_MISMATCH")
endif()
string(JSON workflow ERROR_VARIABLE err GET "${bytes}" workflows 0 id)
if(err OR NOT workflow STREQUAL "Billing.Checkout")
  message(FATAL_ERROR "DURABLE_M0_WORKFLOW_TARGET_MISMATCH")
endif()
foreach(order RANGE 0 2)
  string(JSON actual ERROR_VARIABLE err GET "${bytes}" workflows 0 commands ${order} order)
  if(err OR NOT actual STREQUAL "${order}")
    message(FATAL_ERROR "DURABLE_M0_HISTORY_ORDER_MISMATCH")
  endif()
endforeach()
string(JSON target ERROR_VARIABLE err GET "${bytes}" workflows 0 commands 0 target)
if(err OR NOT target STREQUAL "Billing.PaymentProvider.charge")
  message(FATAL_ERROR "DURABLE_M0_ACTIVITY_BINDING_MISMATCH")
endif()
string(JSON query ERROR_VARIABLE err GET "${bytes}" workflows 0 queries 0 endpoint)
if(err OR NOT query STREQUAL "status")
  message(FATAL_ERROR "DURABLE_M0_QUERY_SEPARATION_MISMATCH")
endif()
message(STATUS "DURABLE_M0_REFERENCE_ONLY|sha256=${digest}|bytes=${nbytes}|history=3|queries=1")
