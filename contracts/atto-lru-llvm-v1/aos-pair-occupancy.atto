// Native compiler guest: AoS2 packed key/value pairs plus separate live[].
pub routine main(): int {
  val Array<int> pairs = new Array<int>();
  val Array<int> live = new Array<int>();
  for (let int i = 0; i < 6; i = i + 1) {
    pairs.add(0);
  }
  for (let int i = 0; i < 3; i = i + 1) {
    live.add(0);
  }
  pairs.set(0, 7);
  pairs.set(1, 70);
  live.set(0, 1);
  pairs.set(2, 21);
  pairs.set(3, 210);
  live.set(1, 1);
  pairs.set(4, 35);
  pairs.set(5, 350);
  live.set(2, 1);
  pairs.set(2, 0);
  pairs.set(3, 0);
  live.set(1, 0);
  if pairs.get(2) != 0 || pairs.get(3) != 0
      || live.get(1) != 0; then return 6; fi
  pairs.set(2, 49);
  pairs.set(3, 490);
  live.set(1, 1);
  if pairs.get(0) == 7 && pairs.get(1) == 70
      && live.get(0) == 1 && pairs.get(2) == 49
      && pairs.get(3) == 490 && live.get(1) == 1
      && pairs.get(4) == 35 && pairs.get(5) == 350
      && live.get(2) == 1; then return 44; fi
  return 7;
}
