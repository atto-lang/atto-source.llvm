// FNV2: Three-layer functors preserve constructors, nominal error slots and callback laziness.
fnc emit(bool yes): void {
  if yes; then stdio.stdout.write("1"); else stdio.stdout.write("0"); fi
  return;
}
fnc forbidden_callback(int value): int {
  stdio.stdout.write("BAD");
  return value + 1;
}
fnc map_three(Option<Option<Result<int,String>>> value): Option<Option<Result<int,String>>> {
  return value.map((Option<Result<int,String>> middle) ->
    middle.map((Result<int,String> inner) -> inner.map((int n) -> n + 1)));
}
fnc map_three_dormant(Option<Option<Result<int,String>>> value): Option<Option<Result<int,String>>> {
  return value.map((Option<Result<int,String>> middle) ->
    middle.map((Result<int,String> inner) -> inner.map((int n) -> forbidden_callback(n))));
}
pub fnc main(): void {
  stdio.stdout.write("FNV2:");
  val Option<Option<Result<int,String>>> nested_ok = Some(Some(Ok(20)));
  val Option<Option<Result<int,String>>> mapped_ok = map_three(nested_ok);
  emit(mapped_ok.unwrap().unwrap().unwrap() eq 21);
  val Option<Option<Result<int,String>>> nested_err = Some(Some(Err("inner")));
  val Option<Option<Result<int,String>>> mapped_err = map_three_dormant(nested_err);
  emit(mapped_err.unwrap().unwrap().is_err());
  val Option<Option<Result<int,String>>> inner_none = Some(None);
  val Option<Option<Result<int,String>>> mapped_inner_none = map_three_dormant(inner_none);
  emit(mapped_inner_none.unwrap().is_none());
  val Option<Option<Result<int,String>>> outer_none = None;
  val Option<Option<Result<int,String>>> mapped_outer_none = map_three_dormant(outer_none);
  emit(mapped_outer_none.is_none());

  val Option<Result<int,String>> collapsed = mapped_ok.flatten();
  emit(collapsed.unwrap().unwrap() eq 21);
  val Result<Option<int>,String> transposed = collapsed.transpose();
  emit(transposed.unwrap().unwrap() eq 21);
  val Result<Option<int>,String> trans_err = mapped_err.flatten().transpose();
  emit(trans_err.is_err());
  val Result<Option<int>,String> trans_none = mapped_inner_none.flatten().transpose();
  emit(trans_none.unwrap().is_none());
  val Result<Option<int>,String> trans_outer_none = mapped_outer_none.flatten().transpose();
  emit(trans_outer_none.unwrap().is_none());

  val Result<Result<Option<int>,String>,String> two_results = Ok(Ok(Some(30)));
  val Result<Option<int>,String> one_result = two_results.flatten();
  emit(one_result.unwrap().unwrap() eq 30);
  val Option<Result<int,String>> flipped = one_result.transpose();
  emit(flipped.unwrap().unwrap() eq 30);
  val Result<Result<Result<int,String>,String>,String> three_results = Ok(Ok(Ok(40)));
  val Result<Result<int,String>,String> one_flatten = three_results.flatten();
  emit(one_flatten.flatten().unwrap() eq 40);
  val Result<Result<Result<int,String>,String>,String> middle_error = Ok(Err("middle"));
  emit(middle_error.flatten().is_err());
  val Result<Result<Result<int,String>,String>,String> outer_error = Err("outer");
  emit(outer_error.flatten().is_err());

  val Option<Result<Option<int>,String>> opt_result_opt = Some(Ok(Some(8)));
  val Result<Option<Option<int>>,String> result_opt_opt = opt_result_opt.transpose();
  emit(result_opt_opt.unwrap().unwrap().unwrap() eq 8);
  val Result<Option<Result<int,String>>,String> result_opt_result = Ok(Some(Ok(9)));
  val Option<Result<Result<int,String>,String>> option_result_result = result_opt_result.transpose();
  emit(option_result_result.unwrap().unwrap().unwrap() eq 9);

  val Result<int,String> err_value = Err("no-call");
  emit(err_value.map((int n) -> forbidden_callback(n)).is_err());
  val Result<int,bool> mapped_error = err_value.map_err((String message) -> true);
  emit(mapped_error.is_err());
  val Result<int,String> ok_value = Ok(17);
  val Result<int,bool> unmapped_success = ok_value.map_err((String message) -> true);
  emit(unmapped_success.unwrap() eq 17);
  val Option<int> absent = None;
  emit(absent.map((int n) -> forbidden_callback(n)).is_none());
  stdio.stdout.write(":END");
  return;
}
