// Portable core runtime Error subclasses (declarations only in this stage).
// Guest methods, tracing and native serialization lowering are tracked by ABI
// and must not be silently replaced with Java/C++ exception instances.
define module errors as

  define pub class RuntimeError extends Error as
    pub val int code;
    pub val String message;
  end

  // Invalid argument or precondition.
  define pub class ArgumentError extends RuntimeError as
  end

  // Expected runtime type was not satisfied.
  define pub class TypeMismatchError extends RuntimeError as
  end

  // Index outside validated bounds.
  define pub class IndexOutOfBoundsError extends RuntimeError as
  end

  // Capability or resource permission denied.
  define pub class PermissionDeniedError extends RuntimeError as
  end

  // Non-actor operation exceeded deadline.
  define pub class TimeoutError extends RuntimeError as
  end

  // Control-plane cancellation, never ordinary trap.
  define pub class CancellationError extends RuntimeError as
  end

  // Network operation failed.
  define pub class NetworkError extends RuntimeError as
  end

  // File operation failed.
  define pub class FileSystemError extends RuntimeError as
  end

  // Invalid text or binary encoding.
  define pub class EncodingError extends RuntimeError as
  end

  // Value cannot be serialized under requested codec.
  define pub class SerializationError extends RuntimeError as
  end

  // Source or data parse failed.
  define pub class ParseError extends RuntimeError as
  end

  // Memory, quota or resource budget exhausted.
  define pub class ResourceLimitError extends RuntimeError as
  end

  // Internal verified contract was violated.
  define pub class InvariantError extends RuntimeError as
  end

end
